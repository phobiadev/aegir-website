---
import Site from '../../layouts/Site.astro';
import ImageSlot from '../../legacy/ImageSlot.astro';
import { events, labels, copy, formatDate, dayNumber, monthShort } from '../../legacy/sample-content';
import { artwork } from '../../config/artwork';
import { site } from '../../legacy/site';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
const others = events.filter((e) => e.slug !== event.slug).slice(0, 3);
---

<Site title={event.title} section="events">
  <!-- ===== Poster header — ink band, no photograph at this stage ===== -->
  <section class="poster">
    <div class="shell poster__content">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/#events">Events</a>
      </nav>
      <div class="plate plate--roundel poster__stamp">
        <img
          src={artwork.pintRoundel.src} alt={artwork.pintRoundel.alt}
          width={artwork.pintRoundel.width} height={artwork.pintRoundel.height}
          decoding="async"
        />
      </div>
      <p class="poster__chips">
        <span class="chip chip--amber">{dayNumber(event.date)} {monthShort(event.date)}</span>
        <span class="chip chip--outline">{event.status}</span>
        {event.example && <span class="example-flag">Placeholder event</span>}
      </p>
      <h1 class="display poster__title">{event.title}</h1>
      <p class="poster__summary">{event.summary}</p>
    </div>
  </section>

  <!-- ===== Body + sticky sidebar ===== -->
  <section class="section detail">
    <div class="shell detail__grid">
      <div class="detail__body">
        <div class="detail__art"><ImageSlot ratio="16 / 9" /></div>
        {event.body.map((para) => <p>{para}</p>)}

        <h2 class="display detail__sub">{labels.subheading}</h2>
        <p>{copy.aboutMore}</p>
      </div>

      <aside class="detail__side">
        <div class="bookbox">
          <p class="bookbox__head">{labels.book}</p>
          <dl class="bookbox__facts">
            <div><dt>Date</dt><dd>{formatDate(event.date)}</dd></div>
            <div><dt>Time</dt><dd>{event.startTime}{event.endTime ? `–${event.endTime}` : ''}</dd></div>
            <div><dt>Venue</dt><dd>{event.venue}</dd></div>
            <div><dt>Price</dt><dd>{event.price}</dd></div>
            <div><dt>Guests</dt><dd>{event.guests}</dd></div>
            {event.dress && <div><dt>Dress</dt><dd>{event.dress}</dd></div>}
          </dl>
          <a
            class="btn btn--amber bookbox__btn"
            href={site.mailingListUrl ?? '#'}
            data-placeholder={site.mailingListUrl ? undefined : true}
            title={site.mailingListUrl ? undefined : 'Booking is not wired up in this prototype'}
          >{labels.primary}</a>
          <a class="bookbox__alt" href="#" data-placeholder title="Calendar export is not part of this prototype">{labels.secondary}</a>
        </div>

        <div class="plate plate--stein detail__ornament">
          <img
            src={artwork.steinDive.src} alt={artwork.steinDive.alt}
            width={artwork.steinDive.width} height={artwork.steinDive.height}
            loading="lazy" decoding="async"
          />
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== More events ===== -->
  <section class="section section--cream-deep">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">{labels.eyebrow}</p>
        <h2 class="display">{labels.more}</h2>
      </div>
      <ul class="cards">
        {others.map((e) => (
          <li class="card">
            <a class="card__media" href={`/events/${e.slug}/`}>
              <ImageSlot ratio="4 / 3" />
              <span class="card__date">
                <span class="card__day">{dayNumber(e.date)}</span>
                <span class="card__mon">{monthShort(e.date)}</span>
              </span>
            </a>
            <div class="card__body">
              <h3 class="card__title"><a href={`/events/${e.slug}/`}>{e.title}</a></h3>
              <p class="card__summary">{e.summary}</p>
              <span class={`chip chip--${e.status.toLowerCase().replace(/\s+/g, '-')}`}>{e.status}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Site>

<style is:global>
  .site .poster {
    background: var(--ink); color: var(--on-ink);
    border-bottom: 6px solid var(--amber);
  }
  .site .poster__content { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); }

  .site .crumb {
    display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem;
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--on-ink-soft);
  }
  .site .crumb a { text-decoration: none; }
  .site .crumb a:hover { color: var(--amber); }

  /* The same mounted roundel as the homepage hero, smaller — it ties the
     event pages back to the opener. */
  .site .poster__stamp { width: 4.5rem; margin-bottom: 1.25rem; border-color: var(--amber); }
  .site .poster__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-bottom: 1.1rem; }
  .site .chip--outline { border-color: var(--amber); color: var(--amber); }
  .site .poster__title { font-size: clamp(2rem, 1rem + 4.4vw, 4.25rem); max-width: 17ch; margin-bottom: 1rem; }
  .site .poster__summary { font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); max-width: 50ch; color: #e8e0cc; line-height: 1.55; }

  .site .detail__grid { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .site .detail__body { max-width: 60ch; font-size: 1.0625rem; line-height: 1.7; }
  .site .detail__art { margin-bottom: 1.75rem; }
  .site .detail__body > p { margin-bottom: 1.2rem; }
  .site .detail__body > p:first-of-type { font-size: 1.1875rem; }
  .site .detail__sub { font-size: 1.375rem; margin: 2.25rem 0 0.85rem; }
  .site .detail__body a { text-underline-offset: 3px; }

  .site .detail__side { position: sticky; top: 5.75rem; }
  .site .bookbox { background: var(--ink); color: var(--on-ink); padding: 1.5rem; border-top: 6px solid var(--amber); }
  .site .bookbox__head {
    font-size: 0.6875rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.16em; color: var(--amber); margin-bottom: 1.1rem;
  }
  .site .bookbox__facts > div { padding: 0.6rem 0; border-bottom: 1px solid rgba(246,239,221,0.14); }
  .site .bookbox__facts dt {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--on-ink-soft); margin-bottom: 0.2rem;
  }
  .site .bookbox__facts dd { font-size: 0.9375rem; font-weight: 600; }
  .site .bookbox__btn { display: block; text-align: center; margin-top: 1.4rem; }
  /* stein-dive's cream is a few units off B's, so it keeps its own paper.
     It is a tall 639×1200 figure — capped so it does not run away down the
     sidebar at full width. */
  .site .detail__ornament { width: 100%; max-width: 11rem; margin: 1.5rem auto 0; }
  .site .bookbox__alt {
    display: block; text-align: center; margin-top: 0.85rem;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--on-ink-soft);
  }

  @media (max-width: 62rem) {
    .site .detail__grid { grid-template-columns: 1fr; }
    .site .detail__side { position: static; }
  }
</style>
