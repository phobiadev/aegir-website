---
/**
 * Direction C — "Common Room".
 * Quiet and institutional. Near-white ground, text serif, persistent left
 * sidebar navigation on desktop collapsing to a top bar on mobile.
 */
import '../styles/reset.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/archivo';
import { site, nav } from '../config/site';
import PrototypeBar from '../components/PrototypeBar.astro';

interface Props {
  title: string;
  section?: string;
}
const { title, section = 'home' } = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name} — Direction C</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Design prototype for Aegir, the Oxford beer society." />
  </head>
  <body class="dir-c">
    <a href="#main" class="skip">Skip to content</a>

    <div class="frame">
      <!-- ===== Persistent sidebar (desktop) / top bar (mobile) ===== -->
      <header class="rail">
        <div class="rail__top">
          <a href="/design-review/c/" class="rail__brand">
            {site.logo
              ? <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} />
              : <span class="rail__wordmark">{site.name}</span>}
            <span class="rail__tag">{site.tagline}</span>
          </a>
          <button class="rail__toggle" type="button" aria-expanded="false" aria-controls="rail-nav">
            <span class="rail__toggle-text">Menu</span>
          </button>
        </div>

        <div class="rail__panel" id="rail-nav">
          <nav aria-label="Primary">
            <ul class="rail__list">
              {nav.map((item) => (
                <li>
                  {item.key === 'home' ? (
                    <a href="/design-review/c/" aria-current={section === 'home' ? 'page' : undefined}>{item.label}</a>
                  ) : (
                    <a href={`/design-review/c/#${item.key}`} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </nav>

          <div class="rail__foot">
            <a
              class="rail__cta"
              href={site.mailingListUrl ?? '#'}
              data-placeholder={site.mailingListUrl ? undefined : true}
              title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
            >Join the mailing list</a>
            <p class="rail__note">{site.instagram}</p>
          </div>
        </div>
      </header>

      <div class="body">
        <main id="main">
          <slot />
        </main>

        <footer class="foot">
          <div class="pad">
            <p class="foot__note">
              Design prototype — Direction C. All events, dates and copy shown are
              invented examples. Links marked{' '}
              <span class="foot__glyph">&#8257;</span>{' '}
              have no destination in this prototype.
            </p>
            <p class="foot__note">Illustrations by {site.instagram}</p>
          </div>
        </footer>
      </div>
    </div>

    <PrototypeBar current="c" />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.rail__toggle');
      const panel = document.querySelector<HTMLElement>('.rail__panel');

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        panel?.classList.toggle('is-open', !open);
      });

      // Collapse after navigating on mobile.
      panel?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
        })
      );
    </script>
  </body>
</html>

<style is:global>
  .dir-c {
    --page: #fcfbf8;
    --cream: #f6efdf;
    --cream-edge: #e9dfc6;
    --ink: #1d1b16;
    --ink-soft: #555045;
    --text: #2e2b24;
    --muted: #6d675a;
    --line: #ddd8cb;
    --line-strong: #1d1b16;
    --accent: #856717;

    --serif: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    --sans: 'Archivo Variable', 'Archivo', ui-sans-serif, system-ui, sans-serif;

    background: var(--page);
    color: var(--text);
    font-family: var(--serif);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.0625rem);
  }

  .dir-c .skip {
    position: absolute; left: -9999px;
    background: var(--ink); color: var(--page);
    padding: 0.75rem 1.25rem; z-index: 10000;
  }
  .dir-c .skip:focus { left: 1rem; top: 1rem; }

  /* ---------- Frame: sidebar + body ---------- */
  .dir-c .frame { display: grid; grid-template-columns: 16.5rem minmax(0, 1fr); min-height: 100vh; }
  .dir-c .body { min-width: 0; }
  .dir-c .pad { padding-inline: clamp(1.5rem, 4vw, 3.5rem); max-width: 60rem; }

  /* ---------- Rail ---------- */
  .dir-c .rail {
    border-right: 1px solid var(--line);
    background: var(--page);
    position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column;
    padding: 2rem 1.5rem;
  }
  .dir-c .rail__brand { display: block; text-decoration: none; margin-bottom: 2.5rem; }
  .dir-c .rail__wordmark {
    display: block; font-family: var(--serif); font-weight: 600;
    font-size: 2rem; letter-spacing: -0.01em; color: var(--ink); line-height: 1;
  }
  .dir-c .rail__brand img { height: auto; margin-bottom: 0.5rem; }
  .dir-c .rail__tag {
    display: block; font-family: var(--sans); font-size: 0.6875rem;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--muted); margin-top: 0.5rem;
  }
  .dir-c .rail__panel { display: flex; flex-direction: column; flex: 1; }
  .dir-c .rail__list { display: grid; gap: 0.1rem; }
  .dir-c .rail__list a {
    display: block; text-decoration: none; padding: 0.5rem 0.7rem;
    font-family: var(--sans); font-size: 0.875rem; color: var(--text);
    border-left: 2px solid transparent; margin-left: -0.7rem;
  }
  .dir-c .rail__list a:hover { background: var(--cream); }
  .dir-c .rail__list a[aria-current='page'] {
    border-left-color: var(--ink); font-weight: 600; color: var(--ink);
  }
  .dir-c .rail__foot { margin-top: auto; padding-top: 2rem; }
  .dir-c .rail__cta {
    display: block; text-align: center; text-decoration: none;
    font-family: var(--sans); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.7rem 0.9rem; border: 1px solid var(--line-strong); color: var(--ink);
  }
  .dir-c .rail__cta:hover { background: var(--ink); color: var(--page); }
  .dir-c .rail__note {
    font-family: var(--sans); font-size: 0.6875rem; color: var(--muted);
    text-align: center; margin-top: 0.9rem; letter-spacing: 0.08em;
  }
  .dir-c .rail__toggle { display: none; }

  /* ---------- Shared type ---------- */
  .dir-c h1, .dir-c h2, .dir-c h3 { font-family: var(--serif); color: var(--ink); font-weight: 600; }
  .dir-c h2 { font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2rem); line-height: 1.18; letter-spacing: -0.005em; }
  .dir-c h3 { font-size: 1.1875rem; line-height: 1.3; }
  .dir-c p { line-height: 1.68; }

  .dir-c .label {
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted);
  }

  .dir-c .rule-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.6rem; margin-bottom: 1.75rem;
  }

  .dir-c .section { padding-top: clamp(2.75rem, 5vw, 4.5rem); }

  .dir-c .btn {
    display: inline-block; text-decoration: none; font-family: var(--sans);
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.04em;
    padding: 0.75rem 1.25rem; border: 1px solid var(--line-strong);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .dir-c .btn--solid { background: var(--ink); color: var(--page); }
  .dir-c .btn--solid:hover { background: transparent; color: var(--ink); }
  .dir-c .btn--line { color: var(--ink); }
  .dir-c .btn--line:hover { background: var(--ink); color: var(--page); }

  .dir-c .example-flag {
    display: inline-block; font-family: var(--sans); font-size: 0.625rem;
    font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); background: var(--cream);
    border: 1px solid var(--cream-edge); padding: 0.18rem 0.45rem;
  }

  .dir-c a[data-placeholder] { color: var(--muted); }
  .dir-c .body a { text-underline-offset: 3px; text-decoration-thickness: 1px; }

  /* ---------- Footer ---------- */
  .dir-c .foot { margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--line); padding: 1.75rem 0 5.5rem; }
  .dir-c .foot__note {
    font-family: var(--sans); font-size: 0.75rem; color: var(--muted);
    line-height: 1.65; max-width: 60ch;
  }
  .dir-c .foot__note + .foot__note { margin-top: 0.4rem; }
  .dir-c .foot__glyph { color: var(--accent); font-weight: 700; }

  /* ---------- Mobile: rail becomes a top bar ---------- */
  @media (max-width: 60rem) {
    .dir-c .frame { grid-template-columns: 1fr; }
    .dir-c .rail {
      position: sticky; top: 0; height: auto; z-index: 100;
      border-right: 0; border-bottom: 1px solid var(--line);
      padding: 0.85rem clamp(1.5rem, 4vw, 2rem);
    }
    .dir-c .rail__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .dir-c .rail__brand { margin-bottom: 0; }
    .dir-c .rail__wordmark { font-size: 1.5rem; }
    .dir-c .rail__tag { display: none; }
    .dir-c .rail__toggle {
      display: block; background: none; cursor: pointer;
      border: 1px solid var(--line-strong); padding: 0.45rem 0.85rem;
      font-family: var(--sans); font-size: 0.75rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink);
    }
    .dir-c .rail__panel { display: none; }
    .dir-c .rail__panel.is-open { display: flex; padding-top: 1rem; }
    .dir-c .rail__list a { margin-left: 0; padding: 0.6rem 0.7rem; border-left: 0; border-bottom: 1px solid var(--line); }
    .dir-c .rail__list a[aria-current='page'] { border-left: 0; background: var(--cream); }
    .dir-c .rail__foot { margin-top: 1.25rem; padding-top: 0; }
  }
</style>
