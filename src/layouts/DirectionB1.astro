---
/**
 * B1 — "Daylight". B's warmth and amber, lifted onto a cream ground.
 * Where B uses big dark slabs, B1 uses paper with ink type and rules, so the
 * supplied illustrations can sit anywhere without a dark section fighting them.
 * Display type is normal-width and mixed-case rather than B's condensed caps.
 */
import '../styles/reset.css';
import '@fontsource-variable/archivo/wdth.css';
import { site, nav } from '../config/site';
import { artwork } from '../config/artwork';
import PrototypeBar from '../components/PrototypeBar.astro';

interface Props { title: string; section?: string }
const { title, section = 'home' } = Astro.props;

/**
 * Paper colours emitted once, from the sampled values in artwork.ts.
 * (`define:vars` is deliberately avoided here: combined with `is:global` it
 * stamps the custom properties onto every element in the page.)
 */
const paperVars = `.dir-b1 {
  --paper-bottle: ${artwork.bottleWalk.paper};
  --paper-disco: ${artwork.disco.paper};
  --paper-roundel: ${artwork.pintRoundel.paper};
  --paper-stein: ${artwork.steinDive.paper};
}`;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name} — Direction B1</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global set:html={paperVars}></style>
  </head>
  <body class="dir-b1">
    <a href="#main" class="skip">Skip to content</a>

    <header class="bar">
      <div class="shell bar__inner">
        <a href="/design-review/b1/" class="bar__brand">
          {site.logo
            ? <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} />
            : <span class="bar__wordmark">{site.name}</span>}
        </a>
        <nav class="bar__nav" aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li>
                {item.key === 'home'
                  ? <a href="/design-review/b1/" aria-current={section === 'home' ? 'page' : undefined}>{item.label}</a>
                  : <a href={`/design-review/b1/#${item.key}`} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>}
              </li>
            ))}
          </ul>
        </nav>
        <a
          class="bar__cta"
          href={site.mailingListUrl ?? '#'}
          data-placeholder={site.mailingListUrl ? undefined : true}
          title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
        >Join</a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="b1-menu" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="sheet" id="b1-menu" hidden>
      <div class="sheet__inner">
        <button class="sheet__close" type="button" aria-label="Close menu">&times;</button>
        <nav aria-label="Mobile">
          <ul class="sheet__list">
            {nav.map((item) => (
              <li>{item.key === 'home'
                ? <a href="/design-review/b1/">{item.label}</a>
                : <a href={`/design-review/b1/#${item.key}`}>{item.label}</a>}</li>
            ))}
          </ul>
        </nav>
        <a
          class="sheet__cta"
          href={site.mailingListUrl ?? '#'}
          data-placeholder={site.mailingListUrl ? undefined : true}
          title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
        >Join the mailing list</a>
      </div>
    </div>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="shell foot__inner">
        <p class="foot__mark">{site.name}</p>
        <p class="foot__tag">{site.tagline}</p>
        <p class="foot__note">
          Design prototype — Direction B1. All events, dates and copy shown are
          invented examples. Links marked{' '}
          <span class="foot__glyph">&#8257;</span>{' '}
          have no destination in this prototype.
        </p>
        <p class="foot__note">Illustrations by {site.instagram}</p>
      </div>
    </footer>

    <PrototypeBar current="b1" />

    <script>
      const burger = document.querySelector<HTMLButtonElement>('.burger');
      const sheet = document.querySelector<HTMLElement>('.sheet');
      const close = document.querySelector<HTMLButtonElement>('.sheet__close');
      function setOpen(open: boolean) {
        if (!sheet || !burger) return;
        sheet.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) close?.focus(); else burger.focus();
      }
      burger?.addEventListener('click', () => setOpen(sheet?.hidden ?? true));
      close?.addEventListener('click', () => setOpen(false));
      sheet?.addEventListener('click', (e) => { if (e.target === sheet) setOpen(false); });
      sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sheet && !sheet.hidden) setOpen(false);
      });
    </script>
  </body>
</html>

<style is:global>
  .dir-b1 {
    /* Grounds are the sampled paper colours of the supplied artwork. */
    --paper: var(--paper-bottle);
    --shade: #F2E7CF;
    --ink: #17150f;
    --ink-soft: #554e3e;
    --ink-faint: #6e675a;
    --amber: #f0bc2e;
    --amber-text: #866918;
    --on-ink: #f6efdd;
    --sans: 'Archivo Variable', 'Archivo', ui-sans-serif, system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-stretch: 100%;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
  }

  .dir-b1 .shell { width: min(100% - 2.5rem, 72rem); margin-inline: auto; }
  .dir-b1 .skip { position: absolute; left: -9999px; background: var(--ink); color: var(--paper); padding: 0.75rem 1.25rem; z-index: 10000; }
  .dir-b1 .skip:focus { left: 1rem; top: 1rem; }

  /* Display: normal width, mixed case, very bold — the opposite of B's caps. */
  .dir-b1 .display { font-weight: 800; letter-spacing: -0.025em; line-height: 1.02; }
  .dir-b1 h2.display { font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3rem); }
  .dir-b1 .eyebrow { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--amber-text); }

  /* ---------- Bar ---------- */
  .dir-b1 .bar { position: sticky; top: 0; z-index: 100; background: var(--paper); border-bottom: 2px solid var(--ink); }
  .dir-b1 .bar__inner { display: flex; align-items: center; gap: 1.5rem; min-height: 4rem; }
  .dir-b1 .bar__brand { text-decoration: none; margin-inline-end: auto; }
  .dir-b1 .bar__wordmark { font-weight: 800; font-size: 1.625rem; letter-spacing: -0.03em; }
  .dir-b1 .bar__nav ul { display: flex; gap: 1.75rem; }
  .dir-b1 .bar__nav a { text-decoration: none; font-size: 0.875rem; font-weight: 600; padding: 0.35rem 0; border-bottom: 2px solid transparent; }
  .dir-b1 .bar__nav a:hover, .dir-b1 .bar__nav a[aria-current='page'] { border-bottom-color: var(--amber); }
  .dir-b1 .bar__cta { background: var(--amber); color: var(--ink); padding: 0.55rem 1.1rem; border-radius: 999px; text-decoration: none; font-size: 0.8125rem; font-weight: 700; border: 2px solid var(--ink); }
  .dir-b1 .bar__cta:hover { background: var(--ink); color: var(--paper); }
  .dir-b1 .burger { display: none; background: none; border: 0; cursor: pointer; padding: 0.5rem; flex-direction: column; gap: 4px; }
  .dir-b1 .burger span { display: block; width: 22px; height: 2px; background: var(--ink); }

  .dir-b1 .sheet { position: fixed; inset: 0; z-index: 200; background: var(--paper); }
  .dir-b1 .sheet[hidden] { display: none; }
  .dir-b1 .sheet__inner { display: flex; flex-direction: column; gap: 2rem; padding: 5rem 2rem 2rem; height: 100%; }
  .dir-b1 .sheet__close { position: absolute; top: 1rem; right: 1.4rem; background: none; border: 0; font-size: 2.5rem; line-height: 1; cursor: pointer; color: var(--ink); }
  .dir-b1 .sheet__list { display: grid; gap: 0.25rem; }
  .dir-b1 .sheet__list a { display: block; text-decoration: none; padding: 0.5rem 0; font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; }
  .dir-b1 .sheet__list a:hover { color: var(--amber-text); }
  .dir-b1 .sheet__cta { margin-top: auto; background: var(--amber); border: 2px solid var(--ink); color: var(--ink); text-align: center; padding: 1rem; text-decoration: none; font-weight: 700; border-radius: 999px; }

  /* ---------- Sections ---------- */
  .dir-b1 .section { padding: clamp(3rem, 6vw, 5rem) 0; }
  .dir-b1 .section--shade { background: var(--shade); }
  /* Illustration-bearing sections carry that illustration's own paper colour. */
  .dir-b1 .section--disco { background: var(--paper-disco); }
  .dir-b1 .section--roundel { background: var(--paper-roundel); }

  .dir-b1 .sechead { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem 1rem; margin-bottom: 2rem; }
  .dir-b1 .sechead .eyebrow { flex-basis: 100%; }

  .dir-b1 .btn { display: inline-block; text-decoration: none; font-size: 0.875rem; font-weight: 700; padding: 0.85rem 1.5rem; border-radius: 999px; border: 2px solid var(--ink); transition: background-color 0.15s ease, color 0.15s ease; }
  .dir-b1 .btn--amber { background: var(--amber); color: var(--ink); }
  .dir-b1 .btn--amber:hover { background: var(--ink); color: var(--paper); }
  .dir-b1 .btn--ink { background: var(--ink); color: var(--paper); }
  .dir-b1 .btn--ink:hover { background: transparent; color: var(--ink); }
  .dir-b1 .btn--ghost { background: transparent; color: var(--ink); }
  .dir-b1 .btn--ghost:hover { background: var(--ink); color: var(--paper); }

  .dir-b1 .chip { display: inline-block; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.3rem 0.65rem; border-radius: 999px; border: 2px solid var(--ink); white-space: nowrap; }
  .dir-b1 .chip--open { background: var(--ink); color: var(--paper); }
  .dir-b1 .chip--waitlist { background: var(--amber); }
  .dir-b1 .chip--members-only { background: transparent; }

  .dir-b1 .example-flag { display: inline-block; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; background: var(--amber); color: var(--ink); padding: 0.2rem 0.5rem; border-radius: 3px; vertical-align: middle; }

  /* ---------- Footer ---------- */
  .dir-b1 .foot { border-top: 2px solid var(--ink); margin-top: clamp(3rem, 6vw, 5rem); }
  .dir-b1 .foot__inner { padding: 2.5rem 0 5.5rem; display: grid; gap: 0.5rem; }
  .dir-b1 .foot__mark { font-weight: 800; font-size: 2.5rem; letter-spacing: -0.035em; line-height: 1; }
  .dir-b1 .foot__tag { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-faint); margin-bottom: 0.75rem; }
  .dir-b1 .foot__note { font-size: 0.75rem; color: var(--ink-soft); max-width: 58ch; line-height: 1.6; }
  .dir-b1 .foot__glyph { color: var(--amber-text); font-weight: 700; }

  @media (max-width: 54rem) {
    .dir-b1 .bar__nav, .dir-b1 .bar__cta { display: none; }
    .dir-b1 .burger { display: flex; }
  }
</style>
