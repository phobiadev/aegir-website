---
/**
 * B2 — "Broadsheet Club". The requested A x B hybrid.
 *
 *   From A: Fraunces display serif, centred masthead between rules, cream
 *           paper ground, ruled editorial lists, drop cap on the event page.
 *   From B: amber as the active colour, photo-led featured event, sticky nav
 *           with a mobile overlay menu, status chips, a full-width CTA band.
 */
import '../styles/reset.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/archivo';
import { site, nav } from '../config/site';
import { artwork } from '../config/artwork';
import PrototypeBar from '../components/PrototypeBar.astro';

interface Props { title: string; section?: string }
const { title, section = 'home' } = Astro.props;

/**
 * Paper colours emitted once, from the sampled values in artwork.ts.
 * (`define:vars` is deliberately avoided here: combined with `is:global` it
 * stamps the custom properties onto every element in the page.)
 */
const paperVars = `.dir-b2 {
  --paper-bottle: ${artwork.bottleWalk.paper};
  --paper-disco: ${artwork.disco.paper};
  --paper-roundel: ${artwork.pintRoundel.paper};
  --paper-stein: ${artwork.steinDive.paper};
}`;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name} — Direction B2</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global set:html={paperVars}></style>
  </head>
  <body class="dir-b2">
    <a href="#main" class="skip">Skip to content</a>

    <!-- A's masthead, but sticky and with B's amber CTA in the corner. -->
    <header class="masthead">
      <div class="masthead__rule masthead__rule--top"></div>
      <div class="shell masthead__inner">
        <p class="masthead__kicker">Oxford</p>
        <a href="/design-review/b2/" class="masthead__wordmark">
          {site.logo
            ? <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} />
            : <span>{site.name}</span>}
        </a>
        <p class="masthead__tagline">{site.tagline}</p>
      </div>
      <div class="masthead__rule"></div>

      <div class="navbar">
        <div class="shell navbar__inner">
          <nav class="navbar__nav" aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li>
                  {item.key === 'home'
                    ? <a href="/design-review/b2/" aria-current={section === 'home' ? 'page' : undefined}>{item.label}</a>
                    : <a href={`/design-review/b2/#${item.key}`} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>}
                </li>
              ))}
            </ul>
          </nav>
          <a
            class="navbar__cta"
            href={site.mailingListUrl ?? '#'}
            data-placeholder={site.mailingListUrl ? undefined : true}
            title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
          >Join the list</a>
          <button class="burger" type="button" aria-expanded="false" aria-controls="b2-menu" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <div class="masthead__rule masthead__rule--thin"></div>
    </header>

    <div class="sheet" id="b2-menu" hidden>
      <div class="sheet__inner">
        <button class="sheet__close" type="button" aria-label="Close menu">&times;</button>
        <nav aria-label="Mobile">
          <ul class="sheet__list">
            {nav.map((item) => (
              <li>{item.key === 'home'
                ? <a href="/design-review/b2/">{item.label}</a>
                : <a href={`/design-review/b2/#${item.key}`}>{item.label}</a>}</li>
            ))}
          </ul>
        </nav>
        <a
          class="sheet__cta"
          href={site.mailingListUrl ?? '#'}
          data-placeholder={site.mailingListUrl ? undefined : true}
          title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
        >Join the mailing list</a>
      </div>
    </div>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="masthead__rule"></div>
      <div class="shell foot__inner">
        <p class="foot__mark">{site.name}</p>
        <p class="foot__note">
          Design prototype — Direction B2. All events, dates and copy shown are
          invented examples. Links marked{' '}
          <span class="foot__glyph">&#8257;</span>{' '}
          have no destination in this prototype.
        </p>
        <p class="foot__note">Illustrations by {site.instagram}</p>
      </div>
    </footer>

    <PrototypeBar current="b2" />

    <script>
      const burger = document.querySelector<HTMLButtonElement>('.burger');
      const sheet = document.querySelector<HTMLElement>('.sheet');
      const close = document.querySelector<HTMLButtonElement>('.sheet__close');
      function setOpen(open: boolean) {
        if (!sheet || !burger) return;
        sheet.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) close?.focus(); else burger.focus();
      }
      burger?.addEventListener('click', () => setOpen(sheet?.hidden ?? true));
      close?.addEventListener('click', () => setOpen(false));
      sheet?.addEventListener('click', (e) => { if (e.target === sheet) setOpen(false); });
      sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sheet && !sheet.hidden) setOpen(false);
      });
    </script>
  </body>
</html>

<style is:global>
  .dir-b2 {
    --paper: var(--paper-bottle);
    --shade: #F2E7CF;
    --ink: #14120e;
    --ink-soft: #4a443a;
    --ink-faint: #6e675a;
    --amber: #f0bc2e;
    --amber-text: #866918;
    --on-ink: #f6efdd;

    --serif: 'Fraunces Variable', 'Fraunces', Georgia, 'Times New Roman', serif;
    --sans: 'Archivo Variable', 'Archivo', ui-sans-serif, system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 14;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
  }

  .dir-b2 .shell { width: min(100% - 2.5rem, 70rem); margin-inline: auto; }
  .dir-b2 .skip { position: absolute; left: -9999px; background: var(--ink); color: var(--paper); padding: 0.75rem 1.25rem; z-index: 10000; }
  .dir-b2 .skip:focus { left: 1rem; top: 1rem; }

  /* ---------- Masthead (from A) ---------- */
  .dir-b2 .masthead { position: sticky; top: 0; z-index: 100; background: var(--paper); }
  .dir-b2 .masthead__rule { height: 3px; background: var(--ink); }
  .dir-b2 .masthead__rule--top { height: 6px; }
  .dir-b2 .masthead__rule--thin { height: 1px; }
  .dir-b2 .masthead__inner { padding: 0.5rem 0 0.4rem; }
  .dir-b2 .masthead__kicker, .dir-b2 .masthead__tagline {
    font-family: var(--sans); text-align: center; text-transform: uppercase;
    letter-spacing: 0.22em; font-size: 0.625rem; font-weight: 500; color: var(--ink-soft);
  }
  .dir-b2 .masthead__wordmark {
    display: block; text-align: center; text-decoration: none;
    font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-weight: 600; font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem);
    line-height: 0.95; letter-spacing: 0.015em; margin: 0.2rem 0 0.25rem;
  }
  .dir-b2 .masthead__wordmark img { margin-inline: auto; height: auto; }

  /* ---------- Nav bar (B's behaviour, A's rules) ---------- */
  .dir-b2 .navbar__inner { display: flex; align-items: center; gap: 1.5rem; min-height: 2.9rem; }
  .dir-b2 .navbar__nav { margin-inline: auto; }
  .dir-b2 .navbar__nav ul { display: flex; gap: clamp(1.1rem, 3vw, 2.5rem); }
  .dir-b2 .navbar__nav a {
    text-decoration: none; font-family: var(--sans); text-transform: uppercase;
    letter-spacing: 0.14em; font-size: 0.6875rem; font-weight: 600;
    padding-bottom: 2px; border-bottom: 2px solid transparent;
  }
  .dir-b2 .navbar__nav a:hover, .dir-b2 .navbar__nav a[aria-current='page'] { border-bottom-color: var(--amber); }
  .dir-b2 .navbar__cta {
    position: absolute; right: max(1.25rem, calc((100vw - 70rem) / 2));
    background: var(--amber); color: var(--ink); text-decoration: none;
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.45rem 0.9rem; border: 1px solid var(--ink);
  }
  .dir-b2 .navbar__cta:hover { background: var(--ink); color: var(--paper); }
  .dir-b2 .burger { display: none; position: absolute; right: 1.25rem; background: none; border: 0; cursor: pointer; padding: 0.4rem; flex-direction: column; gap: 4px; }
  .dir-b2 .burger span { display: block; width: 20px; height: 2px; background: var(--ink); }

  .dir-b2 .sheet { position: fixed; inset: 0; z-index: 200; background: var(--paper); }
  .dir-b2 .sheet[hidden] { display: none; }
  .dir-b2 .sheet__inner { display: flex; flex-direction: column; gap: 2rem; padding: 5rem 2rem 2rem; height: 100%; }
  .dir-b2 .sheet__close { position: absolute; top: 1rem; right: 1.4rem; background: none; border: 0; font-size: 2.5rem; line-height: 1; cursor: pointer; color: var(--ink); }
  .dir-b2 .sheet__list { display: grid; gap: 0.2rem; }
  .dir-b2 .sheet__list a {
    display: block; text-decoration: none; padding: 0.4rem 0;
    font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 72;
    font-weight: 600; font-size: 2.25rem; line-height: 1.1;
  }
  .dir-b2 .sheet__cta {
    margin-top: auto; background: var(--amber); border: 2px solid var(--ink);
    color: var(--ink); text-align: center; padding: 1rem; text-decoration: none;
    font-family: var(--sans); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; font-size: 0.8125rem;
  }

  /* ---------- Shared type ---------- */
  .dir-b2 h2 {
    font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60;
    font-weight: 600; font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.625rem);
    line-height: 1.08; letter-spacing: -0.01em;
  }
  .dir-b2 h3 { font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 30; font-weight: 600; font-size: 1.3125rem; line-height: 1.22; }
  .dir-b2 p { line-height: 1.62; }
  .dir-b2 .lede { font-size: clamp(1.125rem, 1.03rem + 0.6vw, 1.4375rem); line-height: 1.45; }

  .dir-b2 .section-head {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1rem;
    font-family: var(--sans); text-transform: uppercase; letter-spacing: 0.2em;
    font-size: 0.6875rem; font-weight: 600; color: var(--ink-soft);
    padding-bottom: 0.6rem; border-bottom: 1px solid var(--ink); margin-bottom: 1.75rem;
  }
  .dir-b2 .meta { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }

  .dir-b2 .section { padding-top: clamp(2.75rem, 5.5vw, 4.5rem); }
  .dir-b2 .section--disco { background: var(--paper-disco); padding-bottom: clamp(2.75rem, 5.5vw, 4.5rem); }

  .dir-b2 .btn {
    display: inline-block; font-family: var(--sans); font-size: 0.75rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    text-decoration: none; padding: 0.85rem 1.45rem; border: 2px solid var(--ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .dir-b2 .btn--amber { background: var(--amber); color: var(--ink); }
  .dir-b2 .btn--amber:hover { background: var(--ink); color: var(--paper); }
  .dir-b2 .btn--solid { background: var(--ink); color: var(--paper); }
  .dir-b2 .btn--solid:hover { background: transparent; color: var(--ink); }
  .dir-b2 .btn--line:hover { background: var(--ink); color: var(--paper); }

  .dir-b2 .chip {
    display: inline-block; font-family: var(--sans); font-size: 0.625rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    padding: 0.3rem 0.6rem; border: 1px solid var(--ink); white-space: nowrap;
  }
  .dir-b2 .chip--amber { background: var(--amber); }
  .dir-b2 .chip--open { background: var(--ink); color: var(--paper); }
  .dir-b2 .chip--waitlist { background: var(--amber); }
  .dir-b2 .chip--members-only { background: transparent; }

  .dir-b2 .example-flag {
    display: inline-block; font-family: var(--sans); font-size: 0.625rem;
    font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--amber); color: var(--ink); padding: 0.18rem 0.45rem; vertical-align: middle;
  }

  /* ---------- Footer ---------- */
  .dir-b2 .foot { margin-top: clamp(3rem, 6vw, 5rem); }
  .dir-b2 .foot__inner { display: grid; gap: 0.6rem; padding: 2rem 0 5.5rem; text-align: center; justify-items: center; }
  .dir-b2 .foot__mark { font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60; font-size: 2.25rem; font-weight: 600; }
  .dir-b2 .foot__note { font-family: var(--sans); font-size: 0.75rem; color: var(--ink-soft); max-width: 52ch; line-height: 1.6; }
  .dir-b2 .foot__glyph { color: var(--amber-text); font-weight: 700; }

  @media (max-width: 54rem) {
    .dir-b2 .navbar__nav, .dir-b2 .navbar__cta { display: none; }
    .dir-b2 .burger { display: flex; }
    .dir-b2 .navbar__inner { min-height: 2.5rem; }
  }
</style>
