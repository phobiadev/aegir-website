---
/**
 * Direction A — "Ink & Paper".
 * Illustration-led editorial broadsheet on a cream ground that exactly matches
 * the supplied illustrations' own background (#F9F1DE), so the ink drawings
 * read as printed onto the page rather than pasted into boxes.
 */
import '../styles/reset.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/archivo';
import { site, nav } from '../config/site';
import PrototypeBar from '../components/PrototypeBar.astro';

interface Props {
  title: string;
  /** Which nav item to mark current. */
  section?: string;
}
const { title, section = 'home' } = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name} — Direction A</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Design prototype for Aegir, the Oxford beer society." />
  </head>
  <body class="dir-a">
    <a href="#main" class="skip">Skip to content</a>

    <header class="masthead">
      <div class="masthead__rule masthead__rule--top"></div>
      <div class="shell">
        <p class="masthead__kicker">Oxford · est. in good company</p>
        <a href="/design-review/a/" class="masthead__wordmark">
          {site.logo
            ? <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} />
            : <span>{site.name}</span>}
        </a>
        <p class="masthead__tagline">{site.tagline}</p>
      </div>
      <div class="masthead__rule"></div>
      <nav class="mainnav" aria-label="Primary">
        <ul class="shell mainnav__list">
          {nav.map((item) => (
            <li>
              {item.key === 'home' ? (
                <a href="/design-review/a/" aria-current={section === 'home' ? 'page' : undefined}>{item.label}</a>
              ) : (
                <a href={`/design-review/a/#${item.key}`} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="masthead__rule masthead__rule--thin"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="masthead__rule"></div>
      <div class="shell foot__inner">
        <p class="foot__mark">{site.name}</p>
        <p class="foot__note">
          Design prototype — Direction A. All events, dates and copy shown are
          invented examples. Links marked{' '}
          <span class="foot__glyph">&#8257;</span>{' '}
          have no destination in this prototype.
        </p>
        <p class="foot__social">Illustrations by {site.instagram}</p>
      </div>
    </footer>

    <PrototypeBar current="a" />
  </body>
</html>

<style is:global>
  .dir-a {
    --paper: #f9f1de;
    --paper-deep: #f2e7cf;
    --ink: #14120e;
    --ink-soft: #4a443a;
    --ink-faint: #746c5f;
    --rule: #14120e;
    --amber: #866918;

    --serif: 'Fraunces Variable', 'Fraunces', Georgia, 'Times New Roman', serif;
    --sans: 'Archivo Variable', 'Archivo', ui-sans-serif, system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 14;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
  }

  .dir-a .shell {
    width: min(100% - 2.5rem, 68rem);
    margin-inline: auto;
  }

  .dir-a .skip {
    position: absolute; left: -9999px;
    background: var(--ink); color: var(--paper);
    padding: 0.75rem 1.25rem; z-index: 10000;
  }
  .dir-a .skip:focus { left: 1rem; top: 1rem; }

  /* ---------- Masthead ---------- */
  .dir-a .masthead__rule { height: 3px; background: var(--rule); }
  .dir-a .masthead__rule--top { height: 7px; }
  .dir-a .masthead__rule--thin { height: 1px; }

  .dir-a .masthead__kicker,
  .dir-a .masthead__tagline {
    font-family: var(--sans);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .dir-a .masthead__kicker { margin-top: 1.1rem; }
  .dir-a .masthead__tagline { margin-bottom: 1.1rem; }

  .dir-a .masthead__wordmark {
    display: block;
    text-align: center;
    text-decoration: none;
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-weight: 600;
    font-size: clamp(3.5rem, 2rem + 7.5vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin: 0.35rem 0 0.5rem;
  }
  .dir-a .masthead__wordmark img { margin-inline: auto; height: auto; }

  .dir-a .mainnav__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: 0.7rem 0;
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .dir-a .mainnav a { text-decoration: none; padding-bottom: 2px; }
  .dir-a .mainnav a:hover { box-shadow: inset 0 -2px 0 var(--ink); }
  .dir-a .mainnav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--ink); }

  /* ---------- Shared type ---------- */
  .dir-a .section-head {
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ink-soft);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.75rem;
  }

  .dir-a h2 {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60;
    font-weight: 600;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .dir-a h3 {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 30;
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
  }
  .dir-a p { line-height: 1.62; }

  .dir-a .lede {
    font-size: clamp(1.1875rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink);
  }

  .dir-a .meta {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .dir-a a[data-placeholder] { color: var(--ink-soft); }

  .dir-a .example-flag {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid currentColor;
    padding: 0.14rem 0.4rem;
    vertical-align: middle;
  }

  /* ---------- Footer ---------- */
  .dir-a .foot { margin-top: 5rem; }
  .dir-a .foot__inner {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0 5.5rem;
    text-align: center;
  }
  .dir-a .foot__mark {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60;
    font-size: 2rem;
    font-weight: 600;
  }
  .dir-a .foot__note,
  .dir-a .foot__social {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--ink-soft);
    max-width: 44ch;
    margin-inline: auto;
    line-height: 1.6;
  }
  .dir-a .foot__glyph { color: var(--amber); font-weight: 700; }
</style>
