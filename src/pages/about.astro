---
/**
 * About — the society's own words, then the committee.
 *
 * The copy is `content/pages/about.md`: frontmatter for the heading and
 * standfirst, Markdown for the body. The committee comes from
 * `content/settings/committee.json`, in its own display order.
 */
import { getEntry, render } from 'astro:content';
import Site from '../layouts/Site.astro';
import MailingListButton from '../components/MailingListButton.astro';
import { committee, text } from '../lib/content.ts';
import { artwork } from '../config/artwork.ts';
import { url } from '../lib/urls.ts';
import { imageSize } from '../lib/image-size.mjs';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('content/pages/about.md is missing — the About page cannot be built.');
const { Content } = await render(page);
const { title, description, heading, lead } = page.data;
---

<Site title={title} section="/about/" description={description}>
  <section class="pagehead">
    <div class="shell pagehead__grid">
      <div>
        <p class="eyebrow">{title}</p>
        <h1 class="display pagehead__title">{heading ?? title}</h1>
        {lead && <p class="pagehead__lead">{lead}</p>}
      </div>
      <!-- The disco figure shares the page's cream exactly — no ground needed. -->
      <img
        class="art pagehead__art"
        src={url(artwork.disco.src)} alt={artwork.disco.alt}
        width={artwork.disco.width} height={artwork.disco.height}
        fetchpriority="high" decoding="async"
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="prose"><Content /></div>
    </div>
  </section>

  <section class="section section--shade" id="committee">
    <div class="shell">
      <div class="sechead">
        <h2 class="display">{text.committeeHeading}</h2>
      </div>
      {committee.length > 0 ? (
        <ul class="crew">
          {committee.map((person) => (
            <li class="crew__item">
              {person.photo && person.photoAlt && (
                <img
                  class="crew__photo" src={url(person.photo)} alt={person.photoAlt}
                  width={imageSize(person.photo)?.width} height={imageSize(person.photo)?.height}
                  loading="lazy" decoding="async"
                />
              )}
              <p class="crew__role">{person.role}</p>
              <p class="crew__holder">{person.name}</p>
              {person.bio && <p class="crew__bio">{person.bio}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty"><p>{text.noCommittee}</p></div>
      )}
    </div>
  </section>

  <section class="paper--roundel band--top mailband">
    <div class="shell mailband__inner">
      <img
        class="art mailband__badge"
        src={url(artwork.pintRoundel.src)} alt={artwork.pintRoundel.alt}
        width={artwork.pintRoundel.width} height={artwork.pintRoundel.height}
        loading="lazy" decoding="async"
      />
      <div class="mailcard">
        <h2 class="display mailband__head">{text.mailingHeadingShort}</h2>
        <MailingListButton class="btn btn--amber" note />
      </div>
    </div>
  </section>
</Site>

<style is:global>
  .site .crew { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .site .crew__item { border: 2px solid var(--ink); border-left-width: 6px; border-left-color: var(--amber); padding: 1rem 1.15rem; background: var(--paper); }
  .site .crew__photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border: 1px solid var(--ink); margin-bottom: 0.85rem; }
  .site .crew__role { font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber-text); margin-bottom: 0.4rem; }
  .site .crew__holder { font-size: 1.0625rem; font-weight: 700; margin-bottom: 0.2rem; }
  .site .crew__bio { font-size: 0.8125rem; color: var(--ink-soft); line-height: 1.55; margin-top: 0.35rem; }

  /* The mailing band is shared with the homepage, but each page ships its own
     styles, so the rules it needs are repeated here deliberately. */
  .site .mailband { padding: clamp(2.5rem, 5vw, 4rem) 0; }
  .site .mailband__inner { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .site .mailcard { background: var(--ink); color: var(--on-ink); padding: clamp(1.5rem, 3vw, 2.25rem); border-left: 6px solid var(--amber); }
  .site .mailband__badge { width: 100%; }
  .site .mailband__head { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); margin-bottom: 1.1rem; }
  .site .mailband .btn--amber { border-color: var(--amber); }
  .site .mailband a.btn--amber:hover { background: var(--on-ink); color: var(--ink); border-color: var(--on-ink); }
  .site .mailband .inactive-note { color: var(--on-ink-soft); }

  @media (max-width: 62rem) {
    .site .crew { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 44rem) {
    .site .crew { grid-template-columns: 1fr; }
    .site .mailband__inner { grid-template-columns: 1fr; }
    .site .mailband__badge { max-width: 8rem; }
  }
</style>
