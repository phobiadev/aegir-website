---
import DirectionC from '../../../layouts/DirectionC.astro';
import { events, announcements, committee, copy, formatDate, weekdayShort } from '../../../data/sample-content';
import { site } from '../../../config/site';

const next = events[0]!;
---

<DirectionC title="Home">
  <!-- ===== Statement ===== -->
  <section class="intro">
    <div class="pad">
      <p class="label intro__eyebrow">Michaelmas 2026 &middot; Oxford</p>
      <h1 class="intro__head">{copy.introHeading}</h1>
      <p class="intro__lede">{copy.introLead}</p>
      <p class="intro__body">{copy.introBody}</p>
    </div>
  </section>

  <!-- ===== Next event strip ===== -->
  <section class="nextstrip">
    <div class="pad nextstrip__inner">
      <div>
        <p class="label">Next event</p>
        <p class="nextstrip__title">
          <a href={`/design-review/c/events/${next.slug}/`}>{next.title}</a>
        </p>
        <p class="nextstrip__meta">
          {weekdayShort(next.date)} {formatDate(next.date)} &middot; {next.startTime} &middot; {next.venue}
        </p>
      </div>
      <a class="btn btn--solid" href={`/design-review/c/events/${next.slug}/`}>Details</a>
    </div>
  </section>

  <!-- ===== Termcard table ===== -->
  <section id="events" class="section">
    <div class="pad">
      <div class="rule-head">
        <h2>Termcard</h2>
        <span class="example-flag">Example data</span>
      </div>

      <div class="tablewrap">
        <table class="termcard">
          <caption class="visually-hidden">Events for Michaelmas term 2026</caption>
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Event</th>
              <th scope="col">Venue</th>
              <th scope="col">Guests</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {events.map((ev) => (
              <tr>
                <td class="termcard__date">
                  <span class="termcard__weekday">{weekdayShort(ev.date)}</span>
                  <span class="termcard__full">{formatDate(ev.date, { year: undefined })}</span>
                  <span class="termcard__time">{ev.startTime}</span>
                </td>
                <th scope="row" class="termcard__event">
                  <a href={`/design-review/c/events/${ev.slug}/`}>{ev.title}</a>
                  <span class="termcard__summary">{ev.summary}</span>
                </th>
                <td class="termcard__venue">{ev.venue}</td>
                <td class="termcard__guests">{ev.guests}</td>
                <td><span class={`tag tag--${ev.status.toLowerCase().replace(/\s+/g, '-')}`}>{ev.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="undertable">
        Prices are listed on each event page.{' '}
        <a href="#" data-placeholder title="A past-events archive is not part of this prototype">Previous terms</a>
      </p>
    </div>
  </section>

  <!-- ===== Announcements ===== -->
  <section id="announcements" class="section">
    <div class="pad">
      <div class="rule-head"><h2>Announcements</h2></div>
      <ol class="log">
        {announcements.map((a) => (
          <li class="log__item">
            <p class="label log__date">{formatDate(a.date)}</p>
            <div>
              <h3>{a.title}</h3>
              <p class="log__body">{a.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== About and committee ===== -->
  <section id="about" class="section">
    <div class="pad">
      <div class="rule-head"><h2>{copy.aboutHeading}</h2></div>
      <div class="about">
        <div>
          <p class="about__lede">{copy.aboutBody}</p>
          <p class="about__note">{copy.committeeNote}</p>
        </div>
        <img
          class="about__mark"
          src="/media/graphics/illus-disco.jpg"
          alt="Hand-drawn illustration of a figure dancing under a disco ball holding a drink."
          width="467" height="544" loading="lazy" decoding="async"
        />
      </div>

      <h3 class="roster__head">Committee 2026–27</h3>
      <div class="tablewrap">
        <table class="roster">
          <caption class="visually-hidden">Committee roles and remits</caption>
          <thead>
            <tr><th scope="col">Role</th><th scope="col">Holder</th><th scope="col">Remit</th></tr>
          </thead>
          <tbody>
            {committee.map((c) => (
              <tr>
                <th scope="row">{c.role}</th>
                <td>{c.holder}</td>
                <td class="roster__remit">{c.remit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== Mailing list ===== -->
  <section id="mailing" class="section">
    <div class="pad">
      <div class="mailcard">
        <img
          class="mailcard__mark"
          src="/media/graphics/illus-pint-roundel.jpg"
          alt="Hand-drawn roundel of a hand holding up a full pint."
          width="294" height="316" loading="lazy" decoding="async"
        />
        <div>
          <h2>{copy.mailingHeading}</h2>
          <p class="mailcard__body">{copy.mailingBody}</p>
          <a
            class="btn btn--solid"
            href={site.mailingListUrl ?? '#'}
            data-placeholder={site.mailingListUrl ? undefined : true}
            title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
          >{copy.mailingCta}</a>
        </div>
      </div>
    </div>
  </section>
</DirectionC>

<style is:global>
  /* ---------- Intro ---------- */
  .dir-c .intro { padding-top: clamp(2.5rem, 6vw, 5rem); }
  .dir-c .intro__eyebrow { margin-bottom: 1.1rem; }
  .dir-c .intro__head {
    font-size: clamp(1.875rem, 1.25rem + 2.6vw, 3rem);
    line-height: 1.12; letter-spacing: -0.012em;
    max-width: 20ch; margin-bottom: 1.25rem;
  }
  .dir-c .intro__lede { font-size: clamp(1.125rem, 1.05rem + 0.45vw, 1.3125rem); line-height: 1.52; max-width: 54ch; margin-bottom: 1rem; color: var(--ink); }
  .dir-c .intro__body { color: var(--muted); max-width: 56ch; }

  /* ---------- Next strip ---------- */
  .dir-c .nextstrip { margin-top: clamp(2rem, 4vw, 3rem); }
  .dir-c .nextstrip__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1.25rem; background: var(--cream); border: 1px solid var(--cream-edge);
    padding: 1.25rem 1.5rem;
  }
  .dir-c .nextstrip__title { font-size: 1.1875rem; font-weight: 600; color: var(--ink); margin: 0.45rem 0 0.3rem; }
  .dir-c .nextstrip__title a { text-decoration-color: var(--line-strong); }
  .dir-c .nextstrip__meta { font-family: var(--sans); font-size: 0.8125rem; color: var(--muted); }

  /* ---------- Termcard table ---------- */
  .dir-c .tablewrap { overflow-x: auto; }
  .dir-c table { width: 100%; border-collapse: collapse; text-align: left; }
  .dir-c .termcard { min-width: 44rem; }
  .dir-c .termcard thead th {
    font-family: var(--sans); font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted);
    padding: 0 0.9rem 0.65rem 0; border-bottom: 1px solid var(--line);
  }
  .dir-c .termcard tbody tr { border-bottom: 1px solid var(--line); }
  .dir-c .termcard tbody tr:hover { background: var(--cream); }
  .dir-c .termcard td, .dir-c .termcard tbody th { padding: 1rem 0.9rem 1rem 0; vertical-align: top; font-weight: 400; }
  .dir-c .termcard__date { white-space: nowrap; width: 8.5rem; }
  .dir-c .termcard__weekday,
  .dir-c .termcard__time { display: block; font-family: var(--sans); font-size: 0.6875rem; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .dir-c .termcard__full { display: block; font-weight: 600; color: var(--ink); margin: 0.1rem 0; }
  .dir-c .termcard__event a { font-weight: 600; color: var(--ink); text-decoration-color: var(--line-strong); }
  .dir-c .termcard__summary { display: block; font-size: 0.875rem; color: var(--muted); margin-top: 0.3rem; max-width: 34ch; line-height: 1.5; }
  .dir-c .termcard__venue, .dir-c .termcard__guests { font-size: 0.875rem; color: var(--muted); }
  .dir-c .termcard__venue { width: 12rem; }
  .dir-c .termcard__guests { width: 11rem; }

  .dir-c .tag {
    display: inline-block; font-family: var(--sans); font-size: 0.625rem;
    font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.25rem 0.5rem; border: 1px solid var(--line-strong); white-space: nowrap;
  }
  .dir-c .tag--open { background: var(--ink); color: var(--page); }
  .dir-c .tag--waitlist { background: var(--cream); border-color: var(--accent); color: var(--accent); }
  .dir-c .tag--members-only { background: transparent; color: var(--muted); border-color: var(--line); }

  .dir-c .undertable { margin-top: 1.1rem; font-family: var(--sans); font-size: 0.8125rem; color: var(--muted); }

  /* ---------- Announcements log ---------- */
  .dir-c .log { list-style: none; padding: 0; }
  .dir-c .log__item {
    display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.5rem;
    padding: 1.2rem 0; border-bottom: 1px solid var(--line);
  }
  .dir-c .log__item:first-child { border-top: 1px solid var(--line); }
  .dir-c .log__date { padding-top: 0.25rem; }
  .dir-c .log__body { color: var(--muted); max-width: 58ch; margin-top: 0.35rem; }

  /* ---------- About ---------- */
  .dir-c .about { display: grid; grid-template-columns: minmax(0, 1fr) 9rem; gap: 2.5rem; align-items: start; }
  .dir-c .about__lede { font-size: 1.125rem; line-height: 1.6; max-width: 56ch; margin-bottom: 1rem; }
  .dir-c .about__note { font-family: var(--sans); font-size: 0.8125rem; color: var(--muted); max-width: 52ch; line-height: 1.6; }
  .dir-c .about__mark { mix-blend-mode: multiply; width: 100%; height: auto; }

  .dir-c .roster__head { margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--line-strong); }
  .dir-c .roster { min-width: 34rem; }
  .dir-c .roster thead th {
    font-family: var(--sans); font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted);
    padding: 0 0.9rem 0.6rem 0; border-bottom: 1px solid var(--line);
  }
  .dir-c .roster tbody tr { border-bottom: 1px solid var(--line); }
  .dir-c .roster tbody th { font-weight: 600; color: var(--ink); width: 11rem; }
  .dir-c .roster td, .dir-c .roster tbody th { padding: 0.8rem 0.9rem 0.8rem 0; vertical-align: top; }
  .dir-c .roster__remit { font-size: 0.875rem; color: var(--muted); }

  /* ---------- Mailing ---------- */
  .dir-c .mailcard {
    display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 2rem;
    align-items: center; background: var(--cream);
    border: 1px solid var(--cream-edge); padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .dir-c .mailcard__mark { mix-blend-mode: multiply; width: 100%; height: auto; }
  .dir-c .mailcard h2 { margin-bottom: 0.65rem; }
  .dir-c .mailcard__body { max-width: 52ch; margin-bottom: 1.5rem; }

  /* ---------- Responsive ---------- */
  @media (max-width: 48rem) {
    .dir-c .about { grid-template-columns: 1fr; }
    .dir-c .about__mark { max-width: 7rem; }
    .dir-c .log__item { grid-template-columns: 1fr; gap: 0.4rem; }
    .dir-c .mailcard { grid-template-columns: 1fr; gap: 1.25rem; }
    .dir-c .mailcard__mark { max-width: 6rem; }
  }
</style>
