---
import DirectionA from '../../../layouts/DirectionA.astro';
import { events, announcements, committee, copy, formatDate, dayNumber, monthShort, weekdayShort } from '../../../data/sample-content';
import { site } from '../../../config/site';

const upcoming = events;
const next = events[0]!;
---

<DirectionA title="Home">
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__text">
        <p class="meta hero__eyebrow">Michaelmas termcard out now</p>
        <h1 class="hero__head">{copy.introHeading}</h1>
        <p class="lede hero__lede">{copy.introLead}</p>
        <p class="hero__body">{copy.introBody}</p>
        <div class="hero__actions">
          <a href="#events" class="btn btn--solid">See the termcard</a>
          <a href="#mailing" class="btn btn--line">Join the mailing list</a>
        </div>
      </div>
      <div class="hero__art">
        <img
          src="/media/graphics/illus-bottle-walk.jpg"
          alt="Hand-drawn illustration of a figure striding along with a beer bottle for a head, froth spraying out."
          width="774" height="1200" fetchpriority="high" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ===== Next event strip ===== -->
  <section class="nextup">
    <div class="shell nextup__inner">
      <p class="meta">Next up</p>
      <p class="nextup__title">
        <a href={`/design-review/a/events/${next.slug}/`}>{next.title}</a>
      </p>
      <p class="nextup__when">{formatDate(next.date)} · {next.startTime} · {next.venue}</p>
    </div>
  </section>

  <!-- ===== Events ledger ===== -->
  <section id="events" class="block">
    <div class="shell">
      <p class="section-head">Upcoming events <span class="example-flag">Example data</span></p>
      <ol class="ledger">
        {upcoming.map((ev) => (
          <li class="ledger__row">
            <div class="ledger__date">
              <span class="ledger__day">{dayNumber(ev.date)}</span>
              <span class="ledger__month">{monthShort(ev.date)}</span>
              <span class="ledger__weekday">{weekdayShort(ev.date)}</span>
            </div>
            <div class="ledger__body">
              <h3 class="ledger__title">
                <a href={`/design-review/a/events/${ev.slug}/`}>{ev.title}</a>
              </h3>
              <p class="ledger__summary">{ev.summary}</p>
              <p class="meta ledger__meta">
                {ev.startTime}{ev.endTime ? `–${ev.endTime}` : ''} · {ev.venue} · {ev.price}
              </p>
            </div>
            <div class="ledger__status">
              <span class={`pill pill--${ev.status.toLowerCase().replace(/\s+/g, '-')}`}>{ev.status}</span>
              <a class="ledger__more" href={`/design-review/a/events/${ev.slug}/`}>Details &rarr;</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="ledger__foot">
        <a href="#" data-placeholder title="A full archive of past events is not part of this prototype">Past events archive</a>
      </p>
    </div>
  </section>

  <!-- ===== Announcements ===== -->
  <section id="announcements" class="block">
    <div class="shell notice__grid">
      <div>
        <p class="section-head">Announcements</p>
        <dl class="notice">
          {announcements.map((a) => (
            <div class="notice__item">
              <dt>
                <span class="notice__date">{formatDate(a.date, { year: undefined })}</span>
                <span class="notice__title">{a.title}</span>
              </dt>
              <dd>{a.body}</dd>
            </div>
          ))}
        </dl>
      </div>
      <aside class="notice__aside">
        <img
          src="/media/graphics/illus-disco.jpg"
          alt="Hand-drawn illustration of a figure dancing under a disco ball holding a drink."
          width="467" height="544" loading="lazy" decoding="async"
        />
        <p class="meta">Socials run alongside the termcard</p>
      </aside>
    </div>
  </section>

  <!-- ===== About / committee ===== -->
  <section id="about" class="block">
    <div class="shell">
      <p class="section-head">About the society</p>
      <div class="about__grid">
        <div>
          <h2>{copy.aboutHeading}</h2>
          <p class="lede about__lede">{copy.aboutBody}</p>
          <p class="about__note meta">{copy.committeeNote}</p>
        </div>
        <ul class="roster">
          {committee.map((c) => (
            <li class="roster__item">
              <p class="roster__role">{c.role}</p>
              <p class="roster__holder">{c.holder}</p>
              <p class="roster__remit">{c.remit}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="about__more">
        <a href="#" data-placeholder title="A full About page is not part of this prototype">Read more about Aegir</a>
      </p>
    </div>
  </section>

  <!-- ===== Photo band ===== -->
  <section class="band" aria-label="Photograph of a society event">
    <img
      src="/media/photos/photo-beer-tent.jpg"
      alt="A crowded beer hall interior, people standing between long tables."
      width="1600" height="1200" loading="lazy" decoding="async"
    />
  </section>

  <!-- ===== Mailing list ===== -->
  <section id="mailing" class="block">
    <div class="shell mailing">
      <div class="mailing__text">
        <h2>{copy.mailingHeading}</h2>
        <p class="lede">{copy.mailingBody}</p>
        <p>
          <a
            class="btn btn--solid"
            href={site.mailingListUrl ?? '#'}
            data-placeholder={site.mailingListUrl ? undefined : true}
            title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
          >{copy.mailingCta}</a>
        </p>
      </div>
      <img
        class="mailing__badge"
        src="/media/graphics/illus-pint-roundel.jpg"
        alt="Hand-drawn roundel of a hand holding up a full pint."
        width="294" height="316" loading="lazy" decoding="async"
      />
    </div>
  </section>
</DirectionA>

<style is:global>
  /* ---------- Hero ---------- */
  /* bottle-walk paper #F9F1DE — matches --paper, so the hero needs no override. */
  .dir-a .hero { padding-top: clamp(2.5rem, 5vw, 4.5rem); background: #F9F1DE; }
  .dir-a .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .dir-a .hero__eyebrow { margin-bottom: 1.1rem; }
  .dir-a .hero__head {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-weight: 600;
    font-size: clamp(2.25rem, 1.3rem + 3.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-bottom: 1.25rem;
  }
  .dir-a .hero__lede { margin-bottom: 1rem; max-width: 42ch; }
  .dir-a .hero__body { color: var(--ink-soft); max-width: 46ch; }
  .dir-a .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  /* The hero section is painted with this illustration's own sampled paper
     colour, so the artwork bleeds with no visible edge and no blend trick. */
  .dir-a .hero__art img {
    width: 100%; height: auto;
    margin-inline-start: auto;
    max-width: 30rem;
  }

  /* ---------- Buttons ---------- */
  .dir-a .btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border: 2px solid var(--ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .dir-a .btn--solid { background: var(--ink); color: var(--paper); }
  .dir-a .btn--solid:hover { background: transparent; color: var(--ink); }
  .dir-a .btn--line:hover { background: var(--ink); color: var(--paper); }

  /* ---------- Next-up strip ---------- */
  .dir-a .nextup { margin-top: clamp(2.5rem, 5vw, 4rem); border-block: 3px solid var(--rule); background: var(--paper-deep); }
  .dir-a .nextup__inner {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem;
    padding: 1.1rem 0;
  }
  .dir-a .nextup__title { font-size: 1.25rem; font-weight: 600; flex: 1 1 18rem; }
  .dir-a .nextup__title a { text-decoration: none; box-shadow: inset 0 -1px 0 var(--ink); }
  .dir-a .nextup__title a:hover { box-shadow: inset 0 -2px 0 var(--ink); }
  .dir-a .nextup__when { font-family: var(--sans); font-size: 0.8125rem; color: var(--ink-soft); }

  /* ---------- Blocks ---------- */
  .dir-a .block { padding-top: clamp(3rem, 6vw, 5rem); }

  /* ---------- Events ledger ---------- */
  .dir-a .ledger { list-style: none; padding: 0; }
  .dir-a .ledger__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 10rem;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid rgba(20, 18, 14, 0.22);
    align-items: start;
  }
  .dir-a .ledger__row:first-child { border-top: 1px solid rgba(20, 18, 14, 0.22); }
  .dir-a .ledger__date {
    display: grid; justify-items: center; text-align: center;
    border: 2px solid var(--ink); padding: 0.5rem 0.25rem;
  }
  .dir-a .ledger__day {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60;
    font-size: 2.125rem; font-weight: 600; line-height: 1;
  }
  .dir-a .ledger__month {
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; margin-top: 0.2rem;
  }
  .dir-a .ledger__weekday {
    font-family: var(--sans); font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-faint); margin-top: 0.15rem;
  }
  .dir-a .ledger__title { margin-bottom: 0.4rem; }
  .dir-a .ledger__title a { text-decoration: none; }
  .dir-a .ledger__title a:hover { box-shadow: inset 0 -2px 0 var(--ink); }
  .dir-a .ledger__summary { color: var(--ink-soft); max-width: 52ch; margin-bottom: 0.5rem; }
  .dir-a .ledger__status { display: grid; justify-items: end; gap: 0.7rem; text-align: right; }
  .dir-a .ledger__more {
    font-family: var(--sans); font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;
    white-space: nowrap;
  }
  .dir-a .ledger__more:hover { box-shadow: inset 0 -1px 0 var(--ink); }
  .dir-a .ledger__foot { margin-top: 1.5rem; font-family: var(--sans); font-size: 0.8125rem; }

  .dir-a .pill {
    font-family: var(--sans); font-size: 0.625rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    padding: 0.3rem 0.6rem; white-space: nowrap;
    border: 1px solid var(--ink);
  }
  .dir-a .pill--open { background: var(--ink); color: var(--paper); }
  .dir-a .pill--waitlist { background: #f0bc2e; border-color: var(--ink); color: var(--ink); }
  .dir-a .pill--members-only { background: transparent; }

  /* ---------- Announcements ---------- */
  .dir-a .notice__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start;
  }
  .dir-a .notice__item { padding: 1.1rem 0; border-bottom: 1px solid rgba(20, 18, 14, 0.18); }
  .dir-a .notice__item:first-child { padding-top: 0; }
  .dir-a .notice__item dt { margin-bottom: 0.35rem; }
  .dir-a .notice__date {
    display: inline-block; min-width: 7rem;
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-faint);
  }
  .dir-a .notice__title { font-weight: 600; font-size: 1.0625rem; }
  .dir-a .notice__item dd { margin-inline-start: 7rem; color: var(--ink-soft); max-width: 54ch; }
  /* disco paper #F9F1DE */
  .dir-a .notice__aside { text-align: center; background: #F9F1DE; padding: 1rem 1rem 0.75rem; }
  .dir-a .notice__aside img { width: 100%; height: auto; margin-bottom: 0.75rem; }

  /* ---------- About ---------- */
  .dir-a .about__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start;
  }
  .dir-a .about__lede { margin: 1rem 0; max-width: 44ch; }
  .dir-a .about__note { line-height: 1.65; max-width: 40ch; text-transform: none; letter-spacing: 0; font-size: 0.8125rem; }
  .dir-a .roster {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px; background: rgba(20, 18, 14, 0.22);
    border: 1px solid rgba(20, 18, 14, 0.22);
  }
  .dir-a .roster__item { background: var(--paper); padding: 1rem 1.1rem; }
  .dir-a .roster__role {
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 0.4rem;
  }
  .dir-a .roster__holder { font-size: 1.0625rem; font-weight: 600; margin-bottom: 0.2rem; }
  .dir-a .roster__remit { font-family: var(--sans); font-size: 0.75rem; color: var(--ink-faint); line-height: 1.5; }
  .dir-a .about__more { margin-top: 1.5rem; font-family: var(--sans); font-size: 0.8125rem; }

  /* ---------- Photo band ---------- */
  .dir-a .band { margin-top: clamp(3rem, 6vw, 5rem); border-block: 3px solid var(--rule); }
  .dir-a .band img { width: 100%; height: clamp(14rem, 32vw, 24rem); object-fit: cover; }

  /* ---------- Mailing ---------- */
  /* pint-roundel paper #F8EFDE — a hair warmer than the page, so the badge
     sits in its own matched block rather than on the page cream. */
  .dir-a .mailing__badge { background: #F8EFDE; }
  .dir-a .mailing {
    display: grid; grid-template-columns: minmax(0, 1fr) 11rem;
    gap: clamp(1.5rem, 4vw, 3rem); align-items: center;
  }
  .dir-a .mailing__text h2 { margin-bottom: 0.9rem; }
  .dir-a .mailing__text .lede { max-width: 48ch; margin-bottom: 1.5rem; }
  .dir-a .mailing__badge { width: 100%; height: auto; }

  /* ---------- Responsive ---------- */
  @media (max-width: 60rem) {
    .dir-a .hero__grid { grid-template-columns: 1fr; }
    .dir-a .hero__art { order: -1; }
    .dir-a .hero__art img { max-width: 17rem; margin-inline: auto; }
    .dir-a .about__grid,
    .dir-a .notice__grid { grid-template-columns: 1fr; }
    .dir-a .notice__aside { display: flex; align-items: center; gap: 1rem; text-align: left; }
    .dir-a .notice__aside img { max-width: 7rem; margin-bottom: 0; }
  }

  @media (max-width: 40rem) {
    .dir-a .ledger__row { grid-template-columns: 4.25rem minmax(0, 1fr); gap: 1rem; }
    .dir-a .ledger__day { font-size: 1.625rem; }
    .dir-a .ledger__status {
      grid-column: 1 / -1; justify-items: start; text-align: left;
      display: flex; align-items: center; gap: 1rem;
    }
    .dir-a .notice__date { display: block; margin-bottom: 0.2rem; }
    .dir-a .notice__item dd { margin-inline-start: 0; }
    .dir-a .roster { grid-template-columns: 1fr; }
    .dir-a .mailing { grid-template-columns: 1fr; }
    .dir-a .mailing__badge { max-width: 9rem; }
  }
</style>
