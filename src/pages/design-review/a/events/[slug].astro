---
import DirectionA from '../../../../layouts/DirectionA.astro';
import { events, formatDate, weekdayShort } from '../../../../data/sample-content';
import { site } from '../../../../config/site';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
const others = events.filter((e) => e.slug !== event.slug).slice(0, 3);
---

<DirectionA title={event.title} section="events">
  <article class="article">
    <div class="shell">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/design-review/a/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/design-review/a/#events">Events</a>
      </nav>

      <header class="article__head">
        <p class="meta">
          {weekdayShort(event.date)} {formatDate(event.date)}
          {event.example && <span class="example-flag">Example event</span>}
        </p>
        <h1 class="article__title">{event.title}</h1>
        <p class="lede article__standfirst">{event.summary}</p>
      </header>

      <div class="masthead__rule masthead__rule--thin"></div>

      <div class="article__grid">
        <div class="article__body">
          {event.body.map((para) => <p>{para}</p>)}

          <div class="article__cta">
            <a
              class="btn btn--solid"
              href={site.mailingListUrl ?? '#'}
              data-placeholder={site.mailingListUrl ? undefined : true}
              title={site.mailingListUrl ? undefined : 'Booking is not wired up in this prototype'}
            >Book a place</a>
            <a
              class="btn btn--line"
              href="#"
              data-placeholder
              title="Calendar export is not part of this prototype"
            >Add to calendar</a>
          </div>
        </div>

        <aside class="article__side">
          <dl class="facts">
            <div><dt>Date</dt><dd>{formatDate(event.date)}</dd></div>
            <div><dt>Time</dt><dd>{event.startTime}{event.endTime ? `–${event.endTime}` : ''}</dd></div>
            <div><dt>Venue</dt><dd>{event.venue}</dd></div>
            <div><dt>Price</dt><dd>{event.price}</dd></div>
            <div><dt>Guests</dt><dd>{event.guests}</dd></div>
            {event.dress && <div><dt>Dress</dt><dd>{event.dress}</dd></div>}
            <div><dt>Status</dt><dd>{event.status}</dd></div>
          </dl>
          <img
            class="article__ornament"
            src="/media/graphics/illus-stein-dive.jpg"
            alt="Hand-drawn illustration of a pair of legs disappearing into a foaming beer stein."
            width="639" height="1200" loading="lazy" decoding="async"
          />
        </aside>
      </div>

      <section class="alsoon">
        <p class="section-head">Also this term</p>
        <ul class="alsoon__list">
          {others.map((e) => (
            <li>
              <p class="meta">{formatDate(e.date, { year: undefined })}</p>
              <h3><a href={`/design-review/a/events/${e.slug}/`}>{e.title}</a></h3>
              <p class="alsoon__summary">{e.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</DirectionA>

<style is:global>
  .dir-a .article { padding-top: clamp(2rem, 4vw, 3.5rem); }

  .dir-a .crumb {
    display: flex; gap: 0.55rem; align-items: center;
    font-family: var(--sans); font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink-faint); margin-bottom: 1.75rem;
  }
  .dir-a .crumb a { text-decoration: none; }
  .dir-a .crumb a:hover { box-shadow: inset 0 -1px 0 currentColor; }

  .dir-a .article__head { margin-bottom: 1.75rem; }
  .dir-a .article__head .meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .dir-a .article__title {
    font-family: var(--serif);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-weight: 600;
    font-size: clamp(2.125rem, 1.2rem + 3.8vw, 3.75rem);
    line-height: 1.02; letter-spacing: -0.015em;
    margin-bottom: 1rem; max-width: 20ch;
  }
  .dir-a .article__standfirst { max-width: 50ch; color: var(--ink-soft); }

  .dir-a .article__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) 17rem;
    gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start;
    padding-top: 2.25rem;
  }
  .dir-a .article__body { max-width: 58ch; }
  .dir-a .article__body > p { margin-bottom: 1.15rem; }
  /* Drop cap — pure typography, no drawn artwork. */
  .dir-a .article__body > p:first-of-type::first-letter {
    float: left; font-size: 3.6em; line-height: 0.78;
    padding-right: 0.08em; margin-top: 0.06em;
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144; font-weight: 600;
  }
  .dir-a .article__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .dir-a .facts { border-top: 3px solid var(--rule); }
  .dir-a .facts > div {
    display: grid; grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem; padding: 0.65rem 0;
    border-bottom: 1px solid rgba(20, 18, 14, 0.18);
  }
  .dir-a .facts dt {
    font-family: var(--sans); font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink-faint); padding-top: 0.2rem;
  }
  .dir-a .facts dd { font-size: 0.9375rem; }
  .dir-a .article__ornament {
    mix-blend-mode: multiply; width: 100%; height: auto;
    max-width: 11rem; margin: 2rem auto 0;
  }

  .dir-a .alsoon { padding-top: clamp(3rem, 6vw, 4.5rem); }
  .dir-a .alsoon__list {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .dir-a .alsoon__list li { border-top: 1px solid rgba(20, 18, 14, 0.22); padding-top: 0.9rem; }
  .dir-a .alsoon__list .meta { margin-bottom: 0.5rem; }
  .dir-a .alsoon__list h3 { font-size: 1.125rem; margin-bottom: 0.4rem; }
  .dir-a .alsoon__list h3 a { text-decoration: none; }
  .dir-a .alsoon__list h3 a:hover { box-shadow: inset 0 -2px 0 var(--ink); }
  .dir-a .alsoon__summary { font-size: 0.875rem; color: var(--ink-soft); }

  @media (max-width: 60rem) {
    .dir-a .article__grid { grid-template-columns: 1fr; }
    .dir-a .article__ornament { max-width: 8rem; margin-inline: 0; }
    .dir-a .alsoon__list { grid-template-columns: 1fr; }
  }
</style>
