---
import DirectionB3 from '../../../layouts/DirectionB3.astro';
import { events, announcements, committee, copy, formatDate, dayNumber, monthShort, weekdayShort } from '../../../data/sample-content';
import { site } from '../../../config/site';
import { artwork, photos } from '../../../config/artwork';
---

<DirectionB3 title="Home">
  <!-- Full-bleed photo, heavy scrim, poster-scale headline -->
  <section class="hero">
    <img class="hero__photo" src={photos.beerTent.src} alt={photos.beerTent.alt}
         width={photos.beerTent.width} height={photos.beerTent.height} fetchpriority="high" decoding="async" />
    <div class="hero__scrim"></div>
    <div class="shell hero__content">
      <p class="eyebrow hero__eyebrow">Michaelmas termcard out now</p>
      <h1 class="display hero__head">{copy.introHeading}</h1>
      <p class="hero__lede">{copy.introLead}</p>
      <div class="hero__actions">
        <a href="#events" class="btn btn--amber">See the termcard</a>
        <a href="#mailing" class="btn btn--ghost">Join the mailing list</a>
      </div>
    </div>
    <div class="hero__rule"></div>
  </section>

  <!-- Events as big numbered poster rows -->
  <section id="events" class="section">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">Termcard</p>
        <h2 class="display">What&rsquo;s on</h2>
        <span class="example-flag">Example data</span>
      </div>
      <ol class="bills">
        {events.map((ev, i) => (
          <li class="bill">
            <span class="bill__n">{String(i + 1).padStart(2, '0')}</span>
            <a class="bill__media" href={`/design-review/b3/events/${ev.slug}/`}>
              <img src={ev.image!} alt={ev.imageAlt!} width="1050" height="1400" loading="lazy" decoding="async" />
            </a>
            <div class="bill__body">
              <p class="bill__when">
                <span class="bill__date">{weekdayShort(ev.date)} {dayNumber(ev.date)} {monthShort(ev.date)}</span>
                <span class={`chip chip--${ev.status.toLowerCase().replace(/\s+/g, '-')}`}>{ev.status}</span>
              </p>
              <h3 class="display bill__title">
                <a href={`/design-review/b3/events/${ev.slug}/`}>{ev.title}</a>
              </h3>
              <p class="bill__summary">{ev.summary}</p>
              <p class="bill__meta">{ev.startTime}{ev.endTime ? `–${ev.endTime}` : ''} &middot; {ev.venue} &middot; {ev.price}</p>
              <a class="bill__go" href={`/design-review/b3/events/${ev.slug}/`}>Full details &rarr;</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="undernote">
        <a href="#" data-placeholder title="A full archive of past events is not part of this prototype">Past events archive</a>
      </p>
    </div>
  </section>

  <!-- Announcements -->
  <section id="announcements" class="section section--raised">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">Noticeboard</p>
        <h2 class="display">Announcements</h2>
      </div>
      <ul class="notes">
        {announcements.map((a) => (
          <li class="note">
            <p class="note__date">{formatDate(a.date)}</p>
            <div>
              <h3 class="note__title">{a.title}</h3>
              <p class="note__body">{a.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- About: the disco illustration punches out of the dark in its own paper -->
  <section id="about" class="section">
    <div class="shell about">
      <div class="plate plate--disco about__plate">
        <img src={artwork.disco.src} alt={artwork.disco.alt}
             width={artwork.disco.width} height={artwork.disco.height} loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 class="display about__head">{copy.aboutHeading}</h2>
        <p class="about__lede">{copy.aboutBody}</p>
        <p class="about__body">{copy.introBody}</p>
        <a class="btn btn--ghost" href="#" data-placeholder title="A full About page is not part of this prototype">More about Aegir</a>
      </div>
    </div>

    <div class="shell">
      <h3 class="crew__head">The committee</h3>
      <ul class="crew">
        {committee.map((c) => (
          <li class="crew__item">
            <p class="crew__role">{c.role}</p>
            <p class="crew__holder">{c.holder}</p>
            <p class="crew__remit">{c.remit}</p>
          </li>
        ))}
      </ul>
      <p class="crew__note">{copy.committeeNote}</p>
    </div>
  </section>

  <!-- Full-bleed amber band -->
  <section id="mailing" class="mailband">
    <div class="shell mailband__inner">
      <div class="plate plate--roundel mailband__plate">
        <img src={artwork.pintRoundel.src} alt={artwork.pintRoundel.alt}
             width={artwork.pintRoundel.width} height={artwork.pintRoundel.height} loading="lazy" decoding="async" />
      </div>
      <div>
        <h2 class="display mailband__head">{copy.mailingHeading}</h2>
        <p class="mailband__body">{copy.mailingBody}</p>
        <a
          class="btn mailband__btn"
          href={site.mailingListUrl ?? '#'}
          data-placeholder={site.mailingListUrl ? undefined : true}
          title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
        >{copy.mailingCta}</a>
      </div>
    </div>
  </section>
</DirectionB3>

<style is:global>
  /* ---------- Hero ---------- */
  .dir-b3 .hero { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-height: min(86vh, 48rem); }
  .dir-b3 .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; filter: saturate(0.85) contrast(1.05); }
  .dir-b3 .hero__scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(15,14,10,0.62) 0%, rgba(15,14,10,0.80) 50%, rgba(15,14,10,0.97) 100%); }
  .dir-b3 .hero__content { padding: clamp(3rem, 8vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .dir-b3 .hero__eyebrow { margin-bottom: 1.25rem; }
  .dir-b3 .hero__head { font-size: clamp(2.75rem, 1rem + 7.5vw, 7rem); max-width: 15ch; margin-bottom: 1.5rem; }
  .dir-b3 .hero__lede { font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem); max-width: 50ch; line-height: 1.55; color: #ddd4bd; }
  .dir-b3 .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; }
  .dir-b3 .hero__rule { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--amber); }

  /* ---------- Event bills ---------- */
  .dir-b3 .bills { list-style: none; padding: 0; display: grid; gap: 0; }
  .dir-b3 .bill { display: grid; grid-template-columns: 4rem 18rem minmax(0, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; padding: 2rem 0; border-bottom: 1px solid var(--ink-3); }
  .dir-b3 .bill:first-child { border-top: 1px solid var(--ink-3); }
  .dir-b3 .bill__n { font-stretch: 64%; font-weight: 900; font-size: 2.5rem; line-height: 1; color: var(--ink-3); }
  .dir-b3 .bill:hover .bill__n { color: var(--amber); }
  .dir-b3 .bill__media { display: block; overflow: hidden; }
  .dir-b3 .bill__media img { width: 100%; height: 11rem; object-fit: cover; transition: transform 0.4s ease; filter: saturate(0.9); }
  .dir-b3 .bill__media:hover img { transform: scale(1.04); }
  .dir-b3 .bill__when { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 0.7rem; }
  .dir-b3 .bill__date { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--amber); }
  .dir-b3 .bill__title { font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.375rem); margin-bottom: 0.6rem; }
  .dir-b3 .bill__title a { text-decoration: none; }
  .dir-b3 .bill__title a:hover { color: var(--amber); }
  .dir-b3 .bill__summary { color: var(--on-ink-soft); max-width: 54ch; line-height: 1.6; margin-bottom: 0.5rem; }
  .dir-b3 .bill__meta { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--on-ink-soft); margin-bottom: 0.9rem; }
  .dir-b3 .bill__go { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); text-decoration: none; }
  .dir-b3 .bill__go:hover { text-decoration: underline; text-underline-offset: 4px; }
  .dir-b3 .undernote { margin-top: 1.75rem; font-size: 0.8125rem; color: var(--on-ink-soft); }

  /* ---------- Announcements ---------- */
  .dir-b3 .notes { list-style: none; padding: 0; display: grid; gap: 0; }
  .dir-b3 .note { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--ink-3); }
  .dir-b3 .note:first-child { border-top: 1px solid var(--ink-3); }
  .dir-b3 .note__date { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber); padding-top: 0.3rem; }
  .dir-b3 .note__title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.4rem; }
  .dir-b3 .note__body { color: var(--on-ink-soft); max-width: 60ch; line-height: 1.65; }

  /* ---------- About ---------- */
  .dir-b3 .about { display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .dir-b3 .about__head { font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3rem); margin: 0.75rem 0 1rem; }
  .dir-b3 .about__lede { font-size: 1.1875rem; line-height: 1.55; max-width: 48ch; margin-bottom: 0.9rem; }
  .dir-b3 .about__body { color: var(--on-ink-soft); max-width: 52ch; line-height: 1.65; margin-bottom: 1.75rem; }
  .dir-b3 .crew__head { font-stretch: 64%; font-weight: 900; text-transform: uppercase; font-size: 1.75rem; margin: 3.5rem 0 1.25rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--ink-3); }
  .dir-b3 .crew { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--ink-3); border: 1px solid var(--ink-3); }
  .dir-b3 .crew__item { background: var(--ink); padding: 1.2rem 1.3rem; }
  .dir-b3 .crew__role { font-size: 0.625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em; color: var(--amber); margin-bottom: 0.45rem; }
  .dir-b3 .crew__holder { font-size: 1.0625rem; font-weight: 700; margin-bottom: 0.25rem; }
  .dir-b3 .crew__remit { font-size: 0.8125rem; color: var(--on-ink-soft); line-height: 1.5; }
  .dir-b3 .crew__note { margin-top: 1.5rem; font-size: 0.8125rem; color: var(--on-ink-soft); max-width: 54ch; line-height: 1.6; }

  /* ---------- Mailing band ---------- */
  .dir-b3 .mailband { background: var(--amber); color: var(--ink); padding: clamp(3rem, 6vw, 4.5rem) 0; }
  .dir-b3 .mailband__inner { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: clamp(1.75rem, 4vw, 3.5rem); align-items: center; }
  .dir-b3 .mailband__plate { padding: 0.75rem; border-radius: 50%; }
  .dir-b3 .mailband__head { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem); margin-bottom: 0.75rem; }
  .dir-b3 .mailband__body { max-width: 48ch; line-height: 1.65; margin-bottom: 1.75rem; }
  .dir-b3 .mailband__btn { background: var(--ink); color: var(--amber); }
  .dir-b3 .mailband__btn:hover { background: var(--on-ink); color: var(--ink); }

  /* ---------- Responsive ---------- */
  @media (max-width: 68rem) {
    .dir-b3 .bill { grid-template-columns: 3rem 12rem minmax(0, 1fr); }
    .dir-b3 .bill__media img { height: 9rem; }
    .dir-b3 .about { grid-template-columns: 12rem minmax(0, 1fr); }
    .dir-b3 .crew { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 48rem) {
    .dir-b3 .bill { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem 1.25rem; }
    .dir-b3 .bill__media { grid-column: 1 / -1; order: 3; }
    .dir-b3 .bill__media img { height: 12rem; }
    .dir-b3 .note { grid-template-columns: 1fr; gap: 0.5rem; }
    .dir-b3 .about { grid-template-columns: 1fr; }
    .dir-b3 .about__plate { max-width: 13rem; }
    .dir-b3 .crew { grid-template-columns: 1fr; }
    .dir-b3 .mailband__inner { grid-template-columns: 1fr; }
    .dir-b3 .mailband__plate { max-width: 9rem; }
  }
</style>
