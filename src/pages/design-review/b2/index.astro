---
import DirectionB2 from '../../../layouts/DirectionB2.astro';
import { events, announcements, committee, copy, formatDate, dayNumber, monthShort, weekdayShort } from '../../../data/sample-content';
import { site } from '../../../config/site';
import { artwork } from '../../../config/artwork';

const [featured, ...rest] = events;
---

<DirectionB2 title="Home">
  <!-- Standfirst: A's editorial opening, with the bottle-walk illustration
       bleeding off the edge. The band carries that artwork's own paper. -->
  <section class="opener">
    <div class="shell opener__grid">
      <div>
        <p class="meta">Michaelmas termcard out now</p>
        <h1 class="opener__head">{copy.introHeading}</h1>
        <p class="lede opener__lede">{copy.introLead}</p>
        <p class="opener__body">{copy.introBody}</p>
      </div>
      <img
        class="opener__art"
        src={artwork.bottleWalk.src} alt={artwork.bottleWalk.alt}
        width={artwork.bottleWalk.width} height={artwork.bottleWalk.height}
        fetchpriority="high" decoding="async"
      />
    </div>
  </section>

  <!-- B's photo-led featured event, set in A's serif. -->
  <section id="events" class="section">
    <div class="shell">
      <p class="section-head">
        <span>The termcard</span>
        <span class="example-flag">Example data</span>
      </p>

      <article class="feature">
        <a class="feature__media" href={`/design-review/b2/events/${featured!.slug}/`}>
          <img src={featured!.image!} alt={featured!.imageAlt!} width="1050" height="1400" loading="eager" decoding="async" />
        </a>
        <div class="feature__body">
          <p class="feature__chips">
            <span class="chip chip--amber">{dayNumber(featured!.date)} {monthShort(featured!.date)}</span>
            <span class={`chip chip--${featured!.status.toLowerCase().replace(/\s+/g, '-')}`}>{featured!.status}</span>
          </p>
          <h2 class="feature__title">
            <a href={`/design-review/b2/events/${featured!.slug}/`}>{featured!.title}</a>
          </h2>
          <p class="lede feature__summary">{featured!.summary}</p>
          <p class="meta feature__meta">
            {weekdayShort(featured!.date)} &middot; {featured!.startTime}{featured!.endTime ? `–${featured!.endTime}` : ''} &middot; {featured!.venue}
          </p>
          <a class="btn btn--amber" href={`/design-review/b2/events/${featured!.slug}/`}>Full details</a>
        </div>
      </article>

      <!-- A's ruled ledger for the rest. -->
      <ol class="ledger">
        {rest.map((ev) => (
          <li class="ledger__row">
            <div class="ledger__date">
              <span class="ledger__day">{dayNumber(ev.date)}</span>
              <span class="ledger__mon">{monthShort(ev.date)}</span>
            </div>
            <div class="ledger__body">
              <h3 class="ledger__title"><a href={`/design-review/b2/events/${ev.slug}/`}>{ev.title}</a></h3>
              <p class="ledger__summary">{ev.summary}</p>
              <p class="meta">{ev.startTime} &middot; {ev.venue} &middot; {ev.price}</p>
            </div>
            <div class="ledger__end">
              <span class={`chip chip--${ev.status.toLowerCase().replace(/\s+/g, '-')}`}>{ev.status}</span>
              <a class="ledger__go" href={`/design-review/b2/events/${ev.slug}/`}>Details &rarr;</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="undernote">
        <a href="#" data-placeholder title="A full archive of past events is not part of this prototype">Past events archive</a>
      </p>
    </div>
  </section>

  <!-- A's hanging-indent noticeboard, with B's amber date markers. -->
  <section id="announcements" class="section">
    <div class="shell">
      <p class="section-head"><span>Announcements</span></p>
      <dl class="notice">
        {announcements.map((a) => (
          <div class="notice__item">
            <dt>
              <span class="notice__date">{formatDate(a.date, { year: undefined })}</span>
              <span class="notice__title">{a.title}</span>
            </dt>
            <dd>{a.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- About — the whole band is the disco illustration's own paper. -->
  <section id="about" class="section section--disco">
    <div class="shell">
      <p class="section-head"><span>About the society</span></p>
      <div class="about">
        <div>
          <h2>{copy.aboutHeading}</h2>
          <p class="lede about__lede">{copy.aboutBody}</p>
          <p class="about__note meta">{copy.committeeNote}</p>
        </div>
        <img
          class="about__art"
          src={artwork.disco.src} alt={artwork.disco.alt}
          width={artwork.disco.width} height={artwork.disco.height}
          loading="lazy" decoding="async"
        />
      </div>

      <ul class="roster">
        {committee.map((c) => (
          <li class="roster__item">
            <p class="roster__role">{c.role}</p>
            <p class="roster__holder">{c.holder}</p>
            <p class="roster__remit">{c.remit}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- B's full-width amber band, set in A's serif. -->
  <section id="mailing" class="mailband">
    <div class="shell mailband__inner">
      <div>
        <h2 class="mailband__head">{copy.mailingHeading}</h2>
        <p class="lede mailband__body">{copy.mailingBody}</p>
      </div>
      <a
        class="btn btn--solid"
        href={site.mailingListUrl ?? '#'}
        data-placeholder={site.mailingListUrl ? undefined : true}
        title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
      >{copy.mailingCta}</a>
    </div>
  </section>
</DirectionB2>

<style is:global>
  /* Opener band = the bottle-walk illustration's own paper. */
  .dir-b2 .opener { background: var(--paper); padding: clamp(2.25rem, 4.5vw, 3.75rem) 0 clamp(1.5rem, 3vw, 2.5rem); }
  .dir-b2 .opener__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .dir-b2 .opener__head {
    font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-weight: 600; font-size: clamp(2.125rem, 1.25rem + 3.5vw, 3.875rem);
    line-height: 1.02; letter-spacing: -0.015em; margin: 0.9rem 0 1.1rem; max-width: 17ch;
  }
  .dir-b2 .opener__lede { max-width: 42ch; margin-bottom: 0.9rem; }
  .dir-b2 .opener__body { color: var(--ink-soft); max-width: 46ch; }
  .dir-b2 .opener__art { width: 100%; height: auto; max-width: 24rem; margin-inline-start: auto; }

  /* ---------- Featured event ---------- */
  .dir-b2 .feature { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 3.5vw, 3rem); align-items: center; padding-bottom: 2.25rem; border-bottom: 3px solid var(--ink); }
  .dir-b2 .feature__media { display: block; overflow: hidden; border: 2px solid var(--ink); }
  .dir-b2 .feature__media img { width: 100%; height: 22rem; object-fit: cover; transition: transform 0.4s ease; }
  .dir-b2 .feature__media:hover img { transform: scale(1.03); }
  .dir-b2 .feature__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.9rem; }
  .dir-b2 .feature__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.875rem); margin-bottom: 0.8rem; }
  .dir-b2 .feature__title a { text-decoration: none; }
  .dir-b2 .feature__title a:hover { box-shadow: inset 0 -3px 0 var(--amber); }
  .dir-b2 .feature__summary { color: var(--ink-soft); max-width: 44ch; margin-bottom: 0.9rem; }
  .dir-b2 .feature__meta { margin-bottom: 1.5rem; }

  /* ---------- Ledger ---------- */
  .dir-b2 .ledger { list-style: none; padding: 0; }
  .dir-b2 .ledger__row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 9rem; gap: 1.5rem; padding: 1.4rem 0; border-bottom: 1px solid rgba(20,18,14,0.22); align-items: start; }
  .dir-b2 .ledger__date { display: grid; justify-items: center; border: 2px solid var(--ink); padding: 0.45rem 0.2rem; line-height: 1; }
  .dir-b2 .ledger__day { font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 60; font-size: 1.75rem; font-weight: 600; }
  .dir-b2 .ledger__mon { font-family: var(--sans); font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; margin-top: 0.2rem; }
  .dir-b2 .ledger__title { margin-bottom: 0.3rem; }
  .dir-b2 .ledger__title a { text-decoration: none; }
  .dir-b2 .ledger__title a:hover { box-shadow: inset 0 -2px 0 var(--amber); }
  .dir-b2 .ledger__summary { color: var(--ink-soft); max-width: 52ch; margin-bottom: 0.4rem; }
  .dir-b2 .ledger__end { display: grid; justify-items: end; gap: 0.6rem; text-align: right; }
  .dir-b2 .ledger__go { font-family: var(--sans); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; white-space: nowrap; }
  .dir-b2 .ledger__go:hover { box-shadow: inset 0 -1px 0 var(--ink); }
  .dir-b2 .undernote { margin-top: 1.25rem; font-family: var(--sans); font-size: 0.8125rem; }

  /* ---------- Noticeboard ---------- */
  .dir-b2 .notice__item { padding: 1.1rem 0; border-bottom: 1px solid rgba(20,18,14,0.18); }
  .dir-b2 .notice__item:first-child { padding-top: 0; }
  .dir-b2 .notice__item dt { margin-bottom: 0.3rem; }
  .dir-b2 .notice__date { display: inline-block; min-width: 7rem; font-family: var(--sans); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber-text); }
  .dir-b2 .notice__title { font-weight: 600; font-size: 1.0625rem; }
  .dir-b2 .notice__item dd { margin-inline-start: 7rem; color: var(--ink-soft); max-width: 56ch; }

  /* ---------- About ---------- */
  .dir-b2 .about { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .dir-b2 .about__lede { margin: 0.9rem 0; max-width: 46ch; }
  .dir-b2 .about__note { text-transform: none; letter-spacing: 0; font-size: 0.8125rem; line-height: 1.65; max-width: 44ch; }
  .dir-b2 .about__art { width: 100%; height: auto; }
  .dir-b2 .roster { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(20,18,14,0.22); border: 1px solid rgba(20,18,14,0.22); margin-top: 2.5rem; }
  .dir-b2 .roster__item { background: var(--paper-disco); padding: 1rem 1.1rem; }
  .dir-b2 .roster__role { font-family: var(--sans); font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber-text); margin-bottom: 0.35rem; }
  .dir-b2 .roster__holder { font-size: 1.0625rem; font-weight: 600; margin-bottom: 0.2rem; }
  .dir-b2 .roster__remit { font-family: var(--sans); font-size: 0.75rem; color: var(--ink-faint); line-height: 1.5; }

  /* ---------- Mailing band ---------- */
  .dir-b2 .mailband { background: var(--amber); margin-top: clamp(3rem, 6vw, 4.5rem); padding: clamp(2.25rem, 4.5vw, 3.5rem) 0; border-block: 3px solid var(--ink); }
  .dir-b2 .mailband__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.75rem; }
  .dir-b2 .mailband__head { font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); margin-bottom: 0.6rem; }
  .dir-b2 .mailband__body { max-width: 44ch; }

  /* ---------- Responsive ---------- */
  @media (max-width: 62rem) {
    .dir-b2 .opener__grid { grid-template-columns: 1fr; }
    .dir-b2 .opener__art { order: -1; max-width: 14rem; margin-inline: auto; }
    .dir-b2 .feature { grid-template-columns: 1fr; }
    .dir-b2 .feature__media img { height: 15rem; }
    .dir-b2 .about { grid-template-columns: 1fr; }
    .dir-b2 .about__art { max-width: 10rem; }
    .dir-b2 .roster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 44rem) {
    .dir-b2 .ledger__row { grid-template-columns: 3.75rem minmax(0, 1fr); gap: 1rem; }
    .dir-b2 .ledger__end { grid-column: 1 / -1; justify-items: start; text-align: left; display: flex; align-items: center; gap: 1rem; }
    .dir-b2 .notice__date { display: block; margin-bottom: 0.2rem; }
    .dir-b2 .notice__item dd { margin-inline-start: 0; }
    .dir-b2 .roster { grid-template-columns: 1fr; }
  }
</style>
