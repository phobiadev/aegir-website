---
import DirectionB from '../../../layouts/DirectionB.astro';
import { events, announcements, committee, copy, formatDate, dayNumber, monthShort } from '../../../data/sample-content';
import { site } from '../../../config/site';

const [featured, ...rest] = events;
---

<DirectionB title="Home">
  <!-- ===== Hero ===== -->
  <section class="hero">
    <img
      class="hero__photo"
      src="/media/photos/photo-beer-tent.jpg"
      alt="A crowded beer hall interior, people standing between long tables."
      width="1600" height="1200" fetchpriority="high" decoding="async"
    />
    <div class="hero__scrim"></div>
    <div class="shell hero__content">
      <img
        class="hero__badge"
        src="/media/graphics/illus-pint-roundel.jpg"
        alt="Hand-drawn roundel of a hand holding up a full pint."
        width="294" height="316" decoding="async"
      />
      <h1 class="display hero__head">{copy.introHeading}</h1>
      <p class="hero__lede">{copy.introLead}</p>
      <div class="hero__actions">
        <a href="#events" class="btn btn--amber">What&rsquo;s on this term</a>
        <a href="#mailing" class="btn btn--ghost">Join the mailing list</a>
      </div>
    </div>
  </section>

  <!-- ===== Featured event ===== -->
  <section id="events" class="section">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">Next event</p>
        <h2 class="display">On the termcard</h2>
        <span class="example-flag">Example data</span>
      </div>

      <article class="feature">
        <a class="feature__media" href={`/design-review/b/events/${featured!.slug}/`}>
          <img
            src={featured!.image!}
            alt={featured!.imageAlt!}
            width="1050" height="1400" loading="lazy" decoding="async"
          />
        </a>
        <div class="feature__body">
          <p class="chip chip--amber">
            {dayNumber(featured!.date)} {monthShort(featured!.date)} &middot; {featured!.startTime}
          </p>
          <h3 class="display feature__title">
            <a href={`/design-review/b/events/${featured!.slug}/`}>{featured!.title}</a>
          </h3>
          <p class="feature__summary">{featured!.summary}</p>
          <dl class="feature__facts">
            <div><dt>Venue</dt><dd>{featured!.venue}</dd></div>
            <div><dt>Price</dt><dd>{featured!.price}</dd></div>
            <div><dt>Status</dt><dd>{featured!.status}</dd></div>
          </dl>
          <a class="btn btn--ink" href={`/design-review/b/events/${featured!.slug}/`}>Full details</a>
        </div>
      </article>

      <ul class="cards">
        {rest.map((ev) => (
          <li class="card">
            <a class="card__media" href={`/design-review/b/events/${ev.slug}/`}>
              <img src={ev.image!} alt={ev.imageAlt!} width="1050" height="1400" loading="lazy" decoding="async" />
              <span class="card__date">
                <span class="card__day">{dayNumber(ev.date)}</span>
                <span class="card__mon">{monthShort(ev.date)}</span>
              </span>
            </a>
            <div class="card__body">
              <h3 class="card__title"><a href={`/design-review/b/events/${ev.slug}/`}>{ev.title}</a></h3>
              <p class="card__summary">{ev.summary}</p>
              <p class="card__meta">{ev.venue}</p>
              <span class={`chip chip--${ev.status.toLowerCase().replace(/\s+/g, '-')}`}>{ev.status}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Announcements ===== -->
  <section id="announcements" class="section section--ink">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">Noticeboard</p>
        <h2 class="display">Announcements</h2>
      </div>
      <ul class="notes">
        {announcements.map((a) => (
          <li class="note">
            <p class="note__date">{formatDate(a.date)}</p>
            <h3 class="note__title">{a.title}</h3>
            <p class="note__body">{a.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== About ===== -->
  <section id="about" class="section">
    <div class="shell about">
      <div class="about__text">
        <p class="eyebrow">Who we are</p>
        <h2 class="display">{copy.aboutHeading}</h2>
        <p class="about__lede">{copy.aboutBody}</p>
        <p class="about__body">{copy.introBody}</p>
        <a class="btn btn--ghost" href="#" data-placeholder title="A full About page is not part of this prototype">More about Aegir</a>
      </div>
      <img
        class="about__art"
        src="/media/graphics/illus-disco.jpg"
        alt="Hand-drawn illustration of a figure dancing under a disco ball holding a drink."
        width="467" height="544" loading="lazy" decoding="async"
      />
    </div>
  </section>

  <!-- ===== Committee ===== -->
  <section class="section section--cream-deep">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">The committee</p>
        <h2 class="display">Who runs it</h2>
      </div>
      <ul class="crew">
        {committee.map((c) => (
          <li class="crew__item">
            <p class="crew__role">{c.role}</p>
            <p class="crew__holder">{c.holder}</p>
            <p class="crew__remit">{c.remit}</p>
          </li>
        ))}
      </ul>
      <p class="crew__note">{copy.committeeNote}</p>
    </div>
  </section>

  <!-- ===== Mailing list ===== -->
  <section id="mailing" class="mailband">
    <div class="shell mailband__inner">
      <div>
        <h2 class="display mailband__head">{copy.mailingHeading}</h2>
        <p class="mailband__body">{copy.mailingBody}</p>
      </div>
      <a
        class="btn btn--ink mailband__btn"
        href={site.mailingListUrl ?? '#'}
        data-placeholder={site.mailingListUrl ? undefined : true}
        title={site.mailingListUrl ? undefined : 'The society’s real signup URL has not been supplied yet'}
      >{copy.mailingCta}</a>
    </div>
  </section>
</DirectionB>

<style is:global>
  /* ---------- Hero ---------- */
  .dir-b .hero { position: relative; isolation: isolate; min-height: min(78vh, 42rem); display: flex; align-items: flex-end; }
  .dir-b .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .dir-b .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(23,21,15,0.55) 0%, rgba(23,21,15,0.72) 45%, rgba(23,21,15,0.94) 100%);
  }
  .dir-b .hero__content { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem); color: var(--on-ink); }
  .dir-b .hero__badge {
    width: 5.5rem; height: auto; border-radius: 50%;
    margin-bottom: 1.5rem; box-shadow: 0 0 0 3px var(--amber);
  }
  .dir-b .hero__head { font-size: clamp(2.25rem, 1.1rem + 4.6vw, 4.75rem); max-width: 18ch; margin-bottom: 1.25rem; }
  .dir-b .hero__lede { font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); max-width: 48ch; color: #e8e0cc; line-height: 1.55; }
  .dir-b .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }

  /* ---------- Section heads ---------- */
  .dir-b .sechead { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 2.25rem; }
  .dir-b .sechead .eyebrow { flex-basis: 100%; }

  /* ---------- Chips ---------- */
  .dir-b .chip {
    display: inline-block; font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em;
    padding: 0.38rem 0.75rem; border-radius: 999px;
    border: 2px solid var(--ink); white-space: nowrap;
  }
  .dir-b .chip--amber { background: var(--amber); border-color: var(--amber); }
  .dir-b .chip--open { background: var(--ink); color: var(--on-ink); }
  .dir-b .chip--waitlist { background: var(--amber); border-color: var(--amber); }
  .dir-b .chip--members-only { background: transparent; }

  /* ---------- Featured event ---------- */
  .dir-b .feature {
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--cream-deep); border: 3px solid var(--ink);
    margin-bottom: 2.5rem;
  }
  .dir-b .feature__media { display: block; overflow: hidden; }
  .dir-b .feature__media img {
    width: 100%; height: 100%; min-height: 20rem; object-fit: cover;
    transition: transform 0.4s ease;
  }
  .dir-b .feature__media:hover img { transform: scale(1.03); }
  .dir-b .feature__body { padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) 0; align-self: center; }
  .dir-b .feature__title { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); margin: 1rem 0 0.75rem; }
  .dir-b .feature__title a { text-decoration: none; }
  .dir-b .feature__title a:hover { color: var(--amber-deep); }
  .dir-b .feature__summary { color: var(--ink-soft); max-width: 46ch; line-height: 1.6; }
  .dir-b .feature__facts { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.5rem 0; }
  .dir-b .feature__facts dt {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--ink-soft); margin-bottom: 0.2rem;
  }
  .dir-b .feature__facts dd { font-size: 0.9375rem; font-weight: 600; }

  /* ---------- Cards ---------- */
  .dir-b .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; list-style: none; padding: 0; }
  .dir-b .card { display: flex; flex-direction: column; background: var(--cream-deep); border: 2px solid var(--ink); }
  .dir-b .card__media { position: relative; display: block; overflow: hidden; }
  .dir-b .card__media img { width: 100%; height: 13rem; object-fit: cover; transition: transform 0.4s ease; }
  .dir-b .card__media:hover img { transform: scale(1.04); }
  .dir-b .card__date {
    position: absolute; top: 0; left: 0;
    display: grid; justify-items: center; line-height: 1;
    background: var(--amber); color: var(--ink);
    padding: 0.6rem 0.75rem; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
  }
  .dir-b .card__day { font-stretch: 80%; font-weight: 800; font-size: 1.5rem; }
  .dir-b .card__mon { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.15rem; }
  .dir-b .card__body { padding: 1.1rem 1.2rem 1.35rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .dir-b .card__title { font-size: 1.125rem; font-weight: 700; line-height: 1.25; }
  .dir-b .card__title a { text-decoration: none; }
  .dir-b .card__title a:hover { color: var(--amber-deep); }
  .dir-b .card__summary { font-size: 0.875rem; color: var(--ink-soft); line-height: 1.55; }
  .dir-b .card__meta { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-soft); }
  .dir-b .card .chip { align-self: flex-start; margin-top: auto; }

  /* ---------- Announcements ---------- */
  .dir-b .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; list-style: none; padding: 0; }
  .dir-b .note { border-top: 3px solid var(--amber); padding-top: 1.1rem; }
  .dir-b .note__date {
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--amber); margin-bottom: 0.6rem;
  }
  .dir-b .note__title { font-size: 1.1875rem; font-weight: 700; line-height: 1.25; margin-bottom: 0.5rem; }
  .dir-b .note__body { font-size: 0.9375rem; color: var(--on-ink-soft); line-height: 1.6; }

  /* ---------- About ---------- */
  .dir-b .about { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .dir-b .about__lede { font-size: 1.1875rem; line-height: 1.55; margin: 1rem 0; max-width: 48ch; }
  .dir-b .about__body { color: var(--ink-soft); max-width: 50ch; line-height: 1.65; margin-bottom: 1.75rem; }
  /* disco paper #F9F1DE */
  .dir-b .about__art { background: #F9F1DE; width: 100%; height: auto; }

  /* ---------- Committee ---------- */
  .dir-b .crew { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; list-style: none; padding: 0; }
  .dir-b .crew__item { background: var(--cream); border: 2px solid var(--ink); border-left-width: 6px; border-left-color: var(--amber); padding: 1.1rem 1.25rem; }
  .dir-b .crew__role { font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber-deep); margin-bottom: 0.45rem; }
  .dir-b .crew__holder { font-size: 1.0625rem; font-weight: 700; margin-bottom: 0.25rem; }
  .dir-b .crew__remit { font-size: 0.8125rem; color: var(--ink-soft); line-height: 1.5; }
  .dir-b .crew__note { margin-top: 1.5rem; font-size: 0.8125rem; color: var(--ink-soft); max-width: 52ch; line-height: 1.6; }

  /* ---------- Mailing band ---------- */
  .dir-b .mailband { background: var(--amber); padding: clamp(2.5rem, 5vw, 4rem) 0; }
  .dir-b .mailband__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .dir-b .mailband__head { font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3rem); margin-bottom: 0.65rem; }
  .dir-b .mailband__body { max-width: 46ch; line-height: 1.6; }
  .dir-b .mailband__btn { flex-shrink: 0; }

  /* ---------- Responsive ---------- */
  @media (max-width: 62rem) {
    .dir-b .cards, .dir-b .notes, .dir-b .crew { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dir-b .feature { grid-template-columns: 1fr; }
    .dir-b .feature__media img { min-height: 0; height: 16rem; }
    .dir-b .feature__body { padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2rem); }
    .dir-b .about { grid-template-columns: 1fr; }
    .dir-b .about__art { max-width: 12rem; }
  }
  @media (max-width: 44rem) {
    .dir-b .cards, .dir-b .notes, .dir-b .crew { grid-template-columns: 1fr; }
    .dir-b .mailband__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
