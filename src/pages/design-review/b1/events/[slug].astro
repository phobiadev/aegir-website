---
import DirectionB1 from '../../../../layouts/DirectionB1.astro';
import { events, formatDate, dayNumber, monthShort } from '../../../../data/sample-content';
import { site } from '../../../../config/site';
import { artwork } from '../../../../config/artwork';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event } = Astro.props;
const others = events.filter((e) => e.slug !== event.slug).slice(0, 3);
---

<DirectionB1 title={event.title} section="events">
  <section class="head">
    <div class="shell">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/design-review/b1/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/design-review/b1/#events">Events</a>
      </nav>
      <div class="head__grid">
        <div>
          <p class="head__chips">
            <span class="chip chip--waitlist">{dayNumber(event.date)} {monthShort(event.date)}</span>
            <span class={`chip chip--${event.status.toLowerCase().replace(/\s+/g, '-')}`}>{event.status}</span>
            {event.example && <span class="example-flag">Example event</span>}
          </p>
          <h1 class="display head__title">{event.title}</h1>
          <p class="head__summary">{event.summary}</p>
        </div>
        <!-- Contained banner rather than a dark full-bleed hero. -->
        <img class="head__photo" src={event.image!} alt={event.imageAlt!} width="1050" height="1400" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell detail">
      <div class="detail__body">
        {event.body.map((para) => <p>{para}</p>)}
        <h2 class="display detail__sub">Getting there</h2>
        <p>
          The venue is{' '}
          <a href="#" data-placeholder title="A map link is not wired up in this prototype">on the society map</a>.
          If you need step-free access or have any other requirement, tell the
          Secretary when you book and it will be arranged.
        </p>
      </div>

      <aside class="detail__side">
        <div class="box">
          <p class="box__head">The details</p>
          <dl class="box__facts">
            <div><dt>Date</dt><dd>{formatDate(event.date)}</dd></div>
            <div><dt>Time</dt><dd>{event.startTime}{event.endTime ? `–${event.endTime}` : ''}</dd></div>
            <div><dt>Venue</dt><dd>{event.venue}</dd></div>
            <div><dt>Price</dt><dd>{event.price}</dd></div>
            <div><dt>Guests</dt><dd>{event.guests}</dd></div>
            {event.dress && <div><dt>Dress</dt><dd>{event.dress}</dd></div>}
          </dl>
          <a
            class="btn btn--amber box__btn"
            href={site.mailingListUrl ?? '#'}
            data-placeholder={site.mailingListUrl ? undefined : true}
            title={site.mailingListUrl ? undefined : 'Booking is not wired up in this prototype'}
          >Book a place</a>
          <a class="box__alt" href="#" data-placeholder title="Calendar export is not part of this prototype">Add to calendar</a>
        </div>
        <img
          class="detail__art"
          src={artwork.steinDive.src} alt={artwork.steinDive.alt}
          width={artwork.steinDive.width} height={artwork.steinDive.height}
          loading="lazy" decoding="async"
        />
      </aside>
    </div>
  </section>

  <section class="section section--shade">
    <div class="shell">
      <div class="sechead">
        <p class="eyebrow">Keep going</p>
        <h2 class="display">More this term</h2>
      </div>
      <ul class="rows">
        {others.map((e) => (
          <li class="row">
            <a class="row__thumb" href={`/design-review/b1/events/${e.slug}/`}>
              <img src={e.image!} alt={e.imageAlt!} width="1050" height="1400" loading="lazy" decoding="async" />
            </a>
            <div class="row__date">
              <span class="row__day">{dayNumber(e.date)}</span>
              <span class="row__mon">{monthShort(e.date)}</span>
            </div>
            <div class="row__body">
              <h3 class="row__title"><a href={`/design-review/b1/events/${e.slug}/`}>{e.title}</a></h3>
              <p class="row__summary">{e.summary}</p>
            </div>
            <div class="row__end">
              <span class={`chip chip--${e.status.toLowerCase().replace(/\s+/g, '-')}`}>{e.status}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</DirectionB1>

<style is:global>
  .dir-b1 .head { padding: clamp(1.75rem, 4vw, 3rem) 0 0; }
  .dir-b1 .crumb { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); }
  .dir-b1 .crumb a { text-decoration: none; }
  .dir-b1 .crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dir-b1 .head__grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .dir-b1 .head__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1rem; }
  .dir-b1 .head__title { font-size: clamp(2rem, 1.2rem + 3.4vw, 3.5rem); max-width: 18ch; margin-bottom: 1rem; }
  .dir-b1 .head__summary { font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem); color: var(--ink-soft); max-width: 50ch; line-height: 1.55; }
  .dir-b1 .head__photo { width: 100%; height: 18rem; object-fit: cover; border: 2px solid var(--ink); }

  .dir-b1 .detail { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }
  .dir-b1 .detail__body { max-width: 60ch; font-size: 1.0625rem; line-height: 1.7; }
  .dir-b1 .detail__body > p { margin-bottom: 1.15rem; }
  .dir-b1 .detail__body > p:first-of-type { font-size: 1.1875rem; }
  .dir-b1 .detail__sub { font-size: 1.375rem; margin: 2rem 0 0.8rem; }

  .dir-b1 .box { border: 2px solid var(--ink); border-top-width: 6px; border-top-color: var(--amber); padding: 1.35rem; background: var(--shade); }
  .dir-b1 .box__head { font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber-text); margin-bottom: 1rem; }
  .dir-b1 .box__facts > div { padding: 0.55rem 0; border-bottom: 1px solid rgba(23,21,15,0.16); }
  .dir-b1 .box__facts dt { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-faint); margin-bottom: 0.2rem; }
  .dir-b1 .box__facts dd { font-size: 0.9375rem; font-weight: 600; }
  .dir-b1 .box__btn { display: block; text-align: center; margin-top: 1.25rem; }
  .dir-b1 .box__alt { display: block; text-align: center; margin-top: 0.8rem; font-size: 0.8125rem; font-weight: 600; color: var(--ink-soft); }
  /* stein-dive keeps its own paper, which differs slightly from the page. */
  .dir-b1 .detail__art { background: var(--paper-stein); width: 100%; height: auto; max-width: 11rem; margin: 1.75rem auto 0; }

  @media (max-width: 62rem) {
    .dir-b1 .head__grid { grid-template-columns: 1fr; }
    .dir-b1 .head__photo { height: 14rem; }
    .dir-b1 .detail { grid-template-columns: 1fr; }
    .dir-b1 .detail__art { margin-inline: 0; max-width: 8rem; }
  }
</style>
