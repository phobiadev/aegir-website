---
/**
 * Fallback for the society's emblem.
 *
 * The real emblem is in place — `branding.logo` in `content/settings/site.json`
 * points at `logo-mark.png`, see `ASSETS.md` §3 — so nothing on the site
 * renders this today. It is kept because the header, menu and footer all branch
 * on that one setting, and an editor can empty the Emblem box in the CMS at any
 * time; this is what they get instead of three broken images.
 *
 * It is round because the supplied mark is a roundel. Note that the real file
 * is *not* circle-clipped: the drawing breaks out of its own circle at the
 * horns and arms, so `img.bar__logo` and friends set no `border-radius`.
 */
interface Props {
  /** Diameter, as any CSS length. */
  size?: string;
  /** Caption inside the ring. Pass an empty string where there is no room. */
  label?: string;
  class?: string;
}
const { size = '2.5rem', label = 'Logo', class: cls = '' } = Astro.props;
---

<span
  class:list={['logoslot', cls]}
  style={`--logoslot-size:${size}`}
  role="img"
  aria-label="Logo placeholder — the society emblem has not been supplied yet"
  title="The society’s emblem has not been supplied yet"
>
  {label && <span class="logoslot__label">{label}</span>}
</span>

<style is:global>
  .logoslot {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--logoslot-size);
    height: var(--logoslot-size);
    border-radius: 50%;
    /* `color` is set by the layout to something that passes AA on its ground. */
    border: 1px dashed color-mix(in srgb, currentColor 55%, transparent);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, currentColor 14%, transparent) 0 1px,
      transparent 1px 9px
    );
    background-clip: padding-box;
    overflow: hidden;
  }
  .logoslot__label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    text-align: center;
    padding: 0.15rem 0.2rem;
    background-color: inherit;
  }
</style>
